#!/usr/bin/env bash
set -e

echo "=> Building Tailwind CSS..."
RAILS_ENV=development bundle exec rake tailwindcss:build

echo "=> Starting docs server at http://localhost:3000"
echo "   Run 'RAILS_ENV=development bundle exec rake tailwindcss:watch' in another terminal for live CSS reloading."
RAILS_ENV=development bundle exec rails server -p 3000 "$@"
