<turbo-frame id="modal-demo-frame">
  <% position = (params[:position] || "center").to_sym %>
  <%= render Ui::ModalComponent.new(position: position) do %>
    <div class="p-8 max-w-sm">
      <h2 class="text-lg font-semibold mb-2">Modal — <%= position %></h2>
      <p class="text-sm text-neutral-600 dark:text-neutral-400 mb-6">
        This is a live demo rendered via Turbo Frame.
      </p>
      <div class="flex justify-end gap-2">
        <button data-action="click->ui--modal#close"
                class="rounded-lg px-4 py-2 text-sm font-medium border border-neutral-200 dark:border-neutral-700 hover:bg-neutral-50 dark:hover:bg-neutral-800 transition-colors">
          Close
        </button>
      </div>
    </div>
  <% end %>
</turbo-frame>
