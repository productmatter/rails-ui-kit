<div <%= tag.attributes(controller_data) %>>
  <div data-ui--modal-target="backdrop"
       class="fixed inset-0 bg-black/50 backdrop-blur-sm opacity-0 transition-opacity duration-300 ease-in-out z-[60]"
       data-action="click->ui--modal#closeOnBackdropClick"></div>

  <dialog data-ui--modal-target="dialog"
          class="<%= dialog_classes %>">
    <%= content %>
  </dialog>
</div>
