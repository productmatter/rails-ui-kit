<% parts = capture do %>
  <% if header_shown? %>
    <div data-slot="modal-content-header" class="<%= classes_for(:header) %>">
      <% if header? %>
        <%= header %>
      <% else %>
        <div class="min-w-0">
          <% if title.present? %>
            <h2 id="<%= title_id %>" class="<%= TITLE_CLASSES %>"><%= title %></h2>
          <% end %>
          <% if description.present? %>
            <p data-slot="modal-content-description" class="<%= DESCRIPTION_CLASSES %>"><%= description %></p>
          <% end %>
        </div>
        <% if close? %>
          <%= render(close_button) { close_glyph } %>
        <% end %>
      <% end %>
    </div>
  <% end %>
  <div data-slot="modal-content-body" class="<%= classes_for(:body) %>"><%= content %></div>
  <% if footer? %>
    <div data-slot="modal-content-footer" class="<%= classes_for(:footer) %>"><%= footer %></div>
  <% end %>
<% end %>
<%= tag.turbo_frame(**frame_attributes) do %>
  <% if form %>
    <%= form_with(**form_options) { parts } %>
  <% else %>
    <%= parts %>
  <% end %>
<% end %>
