<%= tag.div(**root_attributes(**controller_data)) do %>
  <%= tag.div(trigger, data: { slot: "popover-trigger", "ui--popover-target": "trigger", "ui--overlay-target": "trigger", "ui--anchor-target": "anchor" }) %>
  <%= tag.div(panel, class: panel_wrapper_classes, data: { slot: "popover-panel", "ui--popover-target": "content", "ui--overlay-target": "content", "ui--anchor-target": "floating" }, hidden: true) %>
<% end %>
