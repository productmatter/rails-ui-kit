<dialog
  id="<%= id %>"
  role="alertdialog"
  aria-labelledby="<%= id %>-title"
  aria-describedby="<%= id %>-message"
  class="fixed inset-0 size-auto max-h-none max-w-none overflow-y-auto bg-transparent backdrop:bg-gray-900/50"
  data-ui--dialog-target="dialog"
  data-default-title="<%= title %>"
  data-default-message="<%= message %>"
  data-controller="ui--overlay"
  data-ui--overlay-target="content"
  data-ui--overlay-mode-value="modal"
  data-ui--overlay-scroll-lock-value="true"
>
  <div class="flex min-h-full items-end justify-center p-4 text-center focus:outline-none sm:items-center sm:p-0">
    <div class="<%= wrapper_class %>">
      <div class="<%= body_class %>">
        <div class="sm:flex sm:items-start">
          <div class="<%= icon_wrapper_class %>">
            <svg class="<%= icon_class %>" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126ZM12 15.75h.007v.008H12v-.008Z" />
            </svg>
          </div>
          <div class="mt-3 text-center sm:mt-0 sm:ms-4 sm:text-start">
            <h3 id="<%= id %>-title" data-ui--dialog-title class="<%= title_class %>"><%= title %></h3>
            <div class="mt-2">
              <p id="<%= id %>-message" data-ui--dialog-message class="<%= message_class %>"><%= message %></p>
            </div>
          </div>
        </div>
      </div>
      <form method="dialog" class="<%= footer_class %>">
        <button type="submit" value="cancel" autofocus class="<%= cancel_class %>">
          <%= cancel_label %>
        </button>
        <button type="submit" value="confirm" class="<%= confirm_class %>">
          <%= confirm_label %>
        </button>
      </form>
    </div>
  </div>
</dialog>
