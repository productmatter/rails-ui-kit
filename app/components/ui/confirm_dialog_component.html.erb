<%= tag.dialog(**root_attributes(id: id, **dialog_attributes)) do %>
  <div class="<%= VIEWPORT_CLASSES %>">
    <div class="<%= classes_for(:wrapper) %>">
      <div class="<%= classes_for(:body) %>">
        <div class="sm:flex sm:items-start">
          <% if icon? %>
            <div data-slot="confirm-dialog-icon" aria-hidden="true" class="<%= classes_for(:icon_wrapper) %>"><%= icon %></div>
          <% end %>
          <div class="<%= text_column_classes %>">
            <h3 id="<%= id %>-title" data-ui--dialog-title class="<%= classes_for(:title) %>"><%= title %></h3>
            <div class="mt-2">
              <% if body? %>
                <div id="<%= id %>-message" data-ui--dialog-body class="<%= classes_for(:message) %>"><%= body %></div>
              <% else %>
                <p id="<%= id %>-message" data-ui--dialog-message class="<%= classes_for(:message) %>"><%= message %></p>
              <% end %>
            </div>
          </div>
        </div>
      </div>
      <form method="dialog" class="<%= classes_for(:footer) %>">
        <%= render cancel_button %>
        <%= render confirm_button(confirm_variant) %>
      </form>
    </div>
  </div>
  <%# One server-rendered confirm button per variant. A confirmation that asks for another variant
      clones the matching template, so the button it gets carries Ui::ButtonComponent's own classes
      and JavaScript writes only its label (ui-toast § Business rules, rules 2 and 3). %>
  <% Ui::ConfirmDialogComponent::CONFIRM_VARIANTS.each do |variant| %>
    <template data-ui--dialog-confirm-template="<%= variant %>"><%= render confirm_button(variant) %></template>
  <% end %>
<% end %>
