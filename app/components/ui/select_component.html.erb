<%= tag.div(**root_attributes(data: root_data)) do %>
  <%= content_tag(:select, native_options, select_attributes) %>
  <%= tag.div(**combobox_attributes) do %>
    <span class="truncate data-[placeholder=true]:text-muted-foreground" data-ui--select-target="label"></span>
  <% end %>
  <svg aria-hidden="true" class="pointer-events-none absolute right-2.5 top-1/2 size-4 -translate-y-1/2 text-muted-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <path d="m6 9 6 6 6-6"></path>
  </svg>
  <%= tag.div(**popup_attributes) do %>
    <%= render Ui::Select::ListboxComponent.new(id: control_id, option_set: option_set) %>
  <% end %>
<% end %>
