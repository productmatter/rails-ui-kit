<%= tag.div(**root_attributes(data: primitives.root_data.merge(results_data))) do %>
  <%= content_tag(:select, native_options, select_attributes) %>
  <% if search? %>
    <%= tag.input(**combobox_attributes) %>
    <%# APG keeps this button for touch screen-reader users, who have no other way to open the
        list. It is out of the tab order, because the text field is the control. %>
    <button type="button" tabindex="-1" hidden aria-label="<%= show_options_label %>"
            class="<%= show_options_class %>"
            data-ui--select-target="showOptions" data-action="click->ui--select#toggle">
      <%= render_chevron %>
    </button>
  <% else %>
    <%= tag.div(**combobox_attributes) do %>
      <span class="truncate data-[placeholder=true]:text-muted-foreground" data-ui--select-target="label"></span>
    <% end %>
    <span class="pointer-events-none absolute inset-e-2.5 top-1/2 size-4 -translate-y-1/2 text-muted-foreground"><%= render_chevron %></span>
  <% end %>
  <%= tag.div(**popup_attributes) do %>
    <%= render Ui::Select::ListboxComponent.new(id: control_id, option_set: option_set) %>
    <% if search? %>
      <%= tag.div(no_results, id: empty_id, hidden: true, class: 'px-2 py-6 text-center text-sm text-muted-foreground',
                  data: { 'ui--select-target': 'empty' }) %>
      <%# Announced rather than shown: a screen reader user learns that the list narrowed, or
          emptied, without having to arrow into it. %>
      <%= tag.div(id: status_id, role: 'status', class: 'sr-only', aria: { live: 'polite' },
                  data: { 'ui--select-target': 'status' }) %>
    <% end %>
  <% end %>
<% end %>
