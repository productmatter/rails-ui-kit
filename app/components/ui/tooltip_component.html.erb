<%= tag.div(**root_attributes(**controller_data)) do %>
  <%= tag.div(trigger, data: { slot: "tooltip-trigger", "ui--tooltip-target": "trigger", "ui--anchor-target": "anchor" }) %>
  <%= tag.div(class: TOOLTIP_CLASSES, data: { slot: "tooltip-content", "ui--tooltip-target": "content", "ui--overlay-target": "content", "ui--anchor-target": "floating" }, hidden: true) do %>
    <%= text %>
    <%= tag.div(data: { slot: "tooltip-arrow", "ui--anchor-target": "arrow" }, class: ARROW_CLASSES) %>
  <% end %>
<% end %>
