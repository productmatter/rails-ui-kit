<div <%= tag.attributes(controller_data) %>>
  <%= content_tag :div, data: { "ui--tooltip-target": "trigger" } do %>
    <%= trigger %>
  <% end %>
  <div class="<%= tooltip_classes %>" data-ui--tooltip-target="content">
    <%= text %>
    <div data-ui--tooltip-target="arrow" class="absolute h-2 w-2 rotate-45 bg-neutral-900 dark:bg-white"></div>
  </div>
</div>
