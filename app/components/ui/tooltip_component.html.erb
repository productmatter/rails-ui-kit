<div <%= tag.attributes(controller_data) %>>
  <%= content_tag :div, data: { "ui--tooltip-target": "trigger", "ui--anchor-target": "anchor" } do %>
    <%= trigger %>
  <% end %>
  <div class="<%= tooltip_classes %>" data-ui--tooltip-target="content" data-ui--overlay-target="content" data-ui--anchor-target="floating" hidden>
    <%= text %>
    <div data-ui--anchor-target="arrow" class="absolute h-2 w-2 rotate-45 bg-neutral-900 dark:bg-white"></div>
  </div>
</div>
