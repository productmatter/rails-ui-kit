<%= tag.div(**root_attributes(**toast_attributes)) do %>
  <div class="flex w-full items-start gap-3">
    <% if icon_cell? %>
      <div data-slot="toast-icon" data-ui--toast-target="icon" aria-hidden="true" class="flex shrink-0 py-0.5 <%= ICON_CLASSES.fetch(type) %>">
        <% if icon? %>
          <%= icon %>
        <% else %>
          <svg class="size-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="<%= ICONS.fetch(type) %>" /></svg>
        <% end %>
      </div>
    <% end %>
    <div data-slot="toast-content" class="min-w-0 flex-1 py-0.5">
      <% if title? %>
        <p id="<%= title_id %>" data-slot="toast-title" data-ui--toast-target="title" class="min-w-0 wrap-break-word font-medium"><%= template? ? '' : title_text %></p>
      <% end %>
      <% if description? %>
        <p id="<%= description_id %>" data-slot="toast-description" data-ui--toast-target="description" class="min-w-0 wrap-break-word text-muted-foreground first:text-popover-foreground"><%= template? ? '' : payload.description %></p>
      <% end %>
    </div>
    <%= render close_button do %>
      <svg class="size-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd" /></svg>
    <% end %>
  </div>
  <%# The footer is a full-width row of the card, not part of the text column, so two
      actions have the whole width and align to the card's inline-end padding edge. %>
  <% if actions? %>
    <div data-slot="toast-actions" data-ui--toast-target="actions" class="flex flex-wrap justify-end gap-2">
      <% actions.each do |action| %>
        <%= render Ui::Toast::ActionComponent.new(action) %>
      <% end %>
    </div>
  <% end %>
  <% if countdown? %>
    <div data-slot="toast-progress" aria-hidden="true" class="absolute inset-x-2 bottom-1 h-1 overflow-hidden rounded-full <%= TRACK_CLASSES.fetch(type) %>">
      <div data-ui--toast-target="timer" class="h-full origin-left rtl:origin-right <%= BAR_CLASSES.fetch(type) %>"></div>
    </div>
  <% end %>
<% end %>
