# frozen_string_literal: true

# Pins the unit lane to Rails 8.0, alongside the 7.2 floor, so the matrix covers the range the
# kit claims to support. Mirrors the root Gemfile; see it for what each group is for.
source 'https://rubygems.org'

gemspec path: '../'

gem 'rails', '~> 8.0.0'

# json 3 breaks Rails through 8.1.3.1; see the root Gemfile.
gem 'json', '< 3'

group :development, :test do
  gem 'debug', platforms: %i[mri windows], require: 'debug/prelude'
  gem 'rubocop', '~> 1.88', require: false
end

group :docs do
  gem 'importmap-rails'
  gem 'propshaft'
  gem 'puma'
  gem 'thruster', require: false
  gem 'turbo-rails'
end

group :assets do
  gem 'tailwindcss-rails'
end

group :test do
  gem 'axe-core-api', require: false
  gem 'axe-core-capybara', require: false
  gem 'capybara', require: false
  gem 'selenium-webdriver', require: false
  gem 'sqlite3'
end
