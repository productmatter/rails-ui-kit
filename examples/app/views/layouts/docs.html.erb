<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= content_for?(:title) ? "#{yield :title} — rails-ui-kit" : "rails-ui-kit" %></title>
  <%= stylesheet_link_tag "tailwind", data: { turbo_track: "reload" } %>
  <%= javascript_importmap_tags %>
</head>
<body class="h-full bg-white dark:bg-neutral-950 text-neutral-900 dark:text-neutral-50 antialiased" data-controller="ui--dark-mode">

  <%# Singletons required by toast + confirm demos %>
  <div data-controller="ui--dialog">
    <%= render Ui::ConfirmDialogComponent.new %>
  </div>
  <%= render Ui::ToastContainerComponent.new %>
  <div data-controller="ui--turbo-confirm ui--turbo-disable-with" class="hidden"></div>
  <turbo-frame id="modal"></turbo-frame>

  <div class="flex h-full">

    <%# ── Sidebar ── %>
    <aside class="fixed inset-y-0 left-0 z-40 flex w-56 flex-col overflow-y-auto border-r border-neutral-200 dark:border-neutral-800 bg-white dark:bg-neutral-950">
      <div class="flex-1 px-3 py-8">

        <%# Logo %>
        <%= link_to root_path, class: "mb-8 flex items-center gap-2 px-2" do %>
          <span class="text-sm font-semibold tracking-tight">rails-ui-kit</span>
          <span class="rounded bg-neutral-100 dark:bg-neutral-800 px-1.5 py-0.5 text-[10px] font-medium text-neutral-500 dark:text-neutral-400">
            0.1.0
          </span>
        <% end %>

        <nav class="mt-6 space-y-5 text-sm">
          <div>
            <p class="mb-1 px-2 text-[11px] font-semibold uppercase tracking-wider text-neutral-400 dark:text-neutral-500">
              Getting Started
            </p>
            <ul class="space-y-0.5">
              <li><%= nav_link "Introduction",  root_path %></li>
              <li><%= nav_link "Installation",  installation_path %></li>
            </ul>
          </div>

          <div>
            <p class="mb-1 px-2 text-[11px] font-semibold uppercase tracking-wider text-neutral-400 dark:text-neutral-500">
              Components
            </p>
            <ul class="space-y-0.5">
              <li><%= nav_link "Confirm Dialog", confirm_dialog_path %></li>
              <li><%= nav_link "Dropdown",       dropdown_path %></li>
              <li><%= nav_link "Modal",          modal_path %></li>
              <li><%= nav_link "Popover",        popover_path %></li>
              <li><%= nav_link "Toast",          toast_path %></li>
              <li><%= nav_link "Tooltip",        tooltip_path %></li>
            </ul>
          </div>

          <div>
            <p class="mb-1 px-2 text-[11px] font-semibold uppercase tracking-wider text-neutral-400 dark:text-neutral-500">
              Utilities
            </p>
            <ul class="space-y-0.5">
              <li><%= nav_link "Dark Mode",          dark_mode_path %></li>
              <li><%= nav_link "Form Change",        form_change_path %></li>
              <li><%= nav_link "Turbo Confirm",      turbo_confirm_path %></li>
              <li><%= nav_link "Turbo Disable With", turbo_disable_with_path %></li>
            </ul>
          </div>
        </nav>
      </div>

      <%# Sidebar footer %>
      <div class="border-t border-neutral-200 dark:border-neutral-800 px-5 py-4 flex items-center gap-3">
        <a href="https://github.com/productmatter/rails-ui-kit"
           target="_blank"
           class="flex items-center gap-1.5 text-xs text-neutral-400 hover:text-neutral-700 dark:hover:text-neutral-200 transition-colors">
          <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
          </svg>
          GitHub
        </a>
        <button data-action="click->ui--dark-mode#toggle"
                class="ml-auto text-neutral-400 hover:text-neutral-700 dark:hover:text-neutral-200 transition-colors"
                aria-label="Toggle dark mode">
          <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"/>
          </svg>
        </button>
      </div>
    </aside>

    <%# ── Main ── %>
    <main class="ml-56 flex-1">
      <div class="mx-auto max-w-3xl px-10 py-12">
        <%= yield %>
      </div>
    </main>

  </div>

  <%# Copy-to-clipboard handler %>
  <script>
    document.addEventListener('click', function(e) {
      const btn = e.target.closest('[data-copy-target]');
      if (!btn) return;
      const code = document.querySelector(btn.dataset.copyTarget);
      if (!code) return;
      navigator.clipboard.writeText(code.textContent.trimEnd()).then(function() {
        const original = btn.textContent;
        btn.textContent = 'Copied!';
        setTimeout(function() { btn.textContent = original; }, 2000);
      });
    });
  </script>

</body>
</html>
