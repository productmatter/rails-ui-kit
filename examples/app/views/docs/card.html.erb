<% content_for :title, "Card" %>
<div class="mb-8">
  <p class="mb-2 text-xs font-semibold uppercase tracking-wider text-violet-600 dark:text-violet-400">Components</p>
  <h1 class="text-3xl font-bold tracking-tight mb-3">Card</h1>
  <p class="text-neutral-600 dark:text-neutral-400">
    A surface with a fixed anatomy — header, body, footer — drawn from the
    <code class="text-xs bg-neutral-100 dark:bg-neutral-800 px-1 py-0.5 rounded font-mono">--card</code> tokens.
    Every part is its own component, so each one takes <code class="text-xs bg-neutral-100 dark:bg-neutral-800 px-1 py-0.5 rounded font-mono">class:</code>
    and any HTML attribute.
  </p>
</div>

<%# Plain %>
<h2 class="text-base font-semibold mb-3">Plain</h2>
<div class="rounded-lg border border-neutral-200 dark:border-neutral-800 bg-neutral-50 dark:bg-neutral-900 flex justify-center p-10 mb-8">
  <%= render Ui::CardComponent.new(class: "w-full max-w-sm") do |card| %>
    <% card.with_header do |header| %>
      <% header.with_title { "Monthly active users" } %>
      <% header.with_description { "Unique accounts that signed in during the last 30 days." } %>
    <% end %>
    <% card.with_body do %>
      <p class="text-3xl font-semibold tabular-nums">12,408</p>
    <% end %>
  <% end %>
</div>

<%# Header action %>
<h2 class="text-base font-semibold mb-3">With a header action</h2>
<div class="rounded-lg border border-neutral-200 dark:border-neutral-800 bg-neutral-50 dark:bg-neutral-900 flex justify-center p-10 mb-4">
  <%= render Ui::CardComponent.new(class: "w-full max-w-sm") do |card| %>
    <% card.with_header do |header| %>
      <% header.with_title { "Billing" } %>
      <% header.with_description { "Pro plan, billed yearly. Renews on 1 March." } %>
      <% header.with_action do %>
        <%= render Ui::ButtonComponent.new(variant: :ghost, size: :icon, aria: { label: "Billing options" }) do %>
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <circle cx="5" cy="12" r="1.75"/><circle cx="12" cy="12" r="1.75"/><circle cx="19" cy="12" r="1.75"/>
          </svg>
        <% end %>
      <% end %>
    <% end %>
    <% card.with_body do %>
      <dl class="grid grid-cols-2 gap-y-2 text-sm">
        <dt class="text-muted-foreground">Seats</dt><dd class="text-right tabular-nums">8 of 10</dd>
        <dt class="text-muted-foreground">Next invoice</dt><dd class="text-right tabular-nums">$1,440.00</dd>
      </dl>
    <% end %>
  <% end %>
</div>
<p class="text-sm text-neutral-600 dark:text-neutral-400 mb-8">
  The action takes a second column pinned top-right and spans the title and description. Without an action the header stays a single column.
</p>

<%# Footer %>
<h2 class="text-base font-semibold mb-3">With a footer</h2>
<div class="rounded-lg border border-neutral-200 dark:border-neutral-800 bg-neutral-50 dark:bg-neutral-900 flex justify-center p-10 mb-8">
  <%= render Ui::CardComponent.new(class: "w-full max-w-sm") do |card| %>
    <% card.with_header do |header| %>
      <% header.with_title { "Delete project" } %>
      <% header.with_description { "Removes the project, its environments and every deploy. This cannot be undone." } %>
    <% end %>
    <% card.with_footer(class: "justify-end gap-2 border-t") do %>
      <%= render(Ui::ButtonComponent.new(variant: :outline)) { "Cancel" } %>
      <%= render(Ui::ButtonComponent.new(variant: :destructive)) { "Delete" } %>
    <% end %>
  <% end %>
</div>

<%# Form %>
<h2 class="text-base font-semibold mb-3">Containing a form</h2>
<div class="rounded-lg border border-neutral-200 dark:border-neutral-800 bg-neutral-50 dark:bg-neutral-900 flex justify-center p-10 mb-4">
  <%= form_with url: demo_submit_path, method: :post, class: "w-full max-w-sm" do |f| %>
    <%= render Ui::CardComponent.new do |card| %>
      <% card.with_header do |header| %>
        <% header.with_title { "Invite a teammate" } %>
        <% header.with_description { "They'll get an email with a link to join the workspace." } %>
      <% end %>
      <% card.with_body(class: "grid gap-4") do %>
        <div class="grid gap-2">
          <%= f.label :email, "Email", class: "text-sm font-medium leading-none" %>
          <%= f.email_field :email, placeholder: "name@company.com", required: true,
                class: "h-9 w-full rounded-md border border-input bg-background px-3 text-sm shadow-xs outline-none placeholder:text-muted-foreground focus-visible:border-ring focus-visible:ring-[3px] focus-visible:ring-ring/50" %>
        </div>
        <div class="grid gap-2">
          <%= f.label :role, "Role", class: "text-sm font-medium leading-none" %>
          <%= f.select :role, [["Member", "member"], ["Admin", "admin"]], {},
                class: "h-9 w-full rounded-md border border-input bg-background px-3 text-sm shadow-xs outline-none focus-visible:border-ring focus-visible:ring-[3px] focus-visible:ring-ring/50" %>
        </div>
      <% end %>
      <% card.with_footer(class: "justify-end") do %>
        <%= render(Ui::ButtonComponent.new(type: "submit", data: { turbo_disable_with: "Sending…" })) { "Send invite" } %>
      <% end %>
    <% end %>
  <% end %>
</div>
<p class="text-sm text-neutral-600 dark:text-neutral-400 mb-8">
  Wrap the card in the form rather than the other way round, so the footer's submit button is inside it.
</p>

<%# Usage %>
<h2 class="text-base font-semibold mb-3">Usage</h2>
<div class="rounded-lg overflow-hidden border border-neutral-800 mb-8">
  <div class="flex items-center justify-between bg-neutral-900 px-4 py-2">
    <span class="text-xs text-neutral-400">ERB</span>
    <button data-copy-target="#card-usage" class="text-xs text-neutral-400 hover:text-white transition-colors">Copy</button>
  </div>
  <pre class="bg-neutral-950 px-5 py-4 overflow-x-auto text-sm leading-relaxed"><code id="card-usage" class="text-neutral-200"><%= h(example_card_usage) %></code></pre>
</div>

<%# Parts %>
<h2 class="text-base font-semibold mb-3">Parts</h2>
<div class="overflow-x-auto rounded-lg border border-neutral-200 dark:border-neutral-800 mb-8">
  <table class="w-full text-sm">
    <thead class="bg-neutral-50 dark:bg-neutral-900">
      <tr>
        <th class="text-left px-4 py-3 text-xs font-semibold text-neutral-500 uppercase tracking-wider">Slot</th>
        <th class="text-left px-4 py-3 text-xs font-semibold text-neutral-500 uppercase tracking-wider">On</th>
        <th class="text-left px-4 py-3 text-xs font-semibold text-neutral-500 uppercase tracking-wider">data-slot</th>
        <th class="text-left px-4 py-3 text-xs font-semibold text-neutral-500 uppercase tracking-wider">Description</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-neutral-100 dark:divide-neutral-800">
      <% [
        ["with_header",      "card",   "card-header",      "Holds the title, description and action. Two columns when an action is present."],
        ["with_body",        "card",   "card-content",     "The main content, padded to line up with the header and footer."],
        ["with_footer",      "card",   "card-footer",      "A flex row, vertically centred. Add justify-end or gap-* for button rows."],
        ["with_title",       "header", "card-title",       "The card's heading text."],
        ["with_description", "header", "card-description", "Supporting text in the muted foreground colour."],
        ["with_action",      "header", "card-action",      "Pinned to the header's top-right corner."],
      ].each do |slot, parent, data_slot, desc| %>
        <tr class="hover:bg-neutral-50 dark:hover:bg-neutral-900/50">
          <td class="px-4 py-3 font-mono text-xs text-violet-600 dark:text-violet-400"><%= slot %></td>
          <td class="px-4 py-3 text-neutral-500"><%= parent %></td>
          <td class="px-4 py-3 font-mono text-xs text-neutral-400"><%= data_slot %></td>
          <td class="px-4 py-3 text-neutral-600 dark:text-neutral-400"><%= desc %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<%# Notes %>
<h2 class="text-base font-semibold mb-3">Notes</h2>
<ul class="space-y-2 text-sm text-neutral-600 dark:text-neutral-400 list-disc list-inside">
  <li>Parts always render in the same order — header, body, footer — whatever order you call them in. Parts you don't set render nothing.</li>
  <li>Every part accepts <code class="text-xs bg-neutral-100 dark:bg-neutral-800 px-1 py-0.5 rounded">class:</code>, merged with tailwind_merge so yours wins, plus any other HTML attribute (<code class="text-xs bg-neutral-100 dark:bg-neutral-800 px-1 py-0.5 rounded">id:</code>, <code class="text-xs bg-neutral-100 dark:bg-neutral-800 px-1 py-0.5 rounded">data:</code>, <code class="text-xs bg-neutral-100 dark:bg-neutral-800 px-1 py-0.5 rounded">aria:</code>).</li>
  <li>The body slot is <code class="text-xs bg-neutral-100 dark:bg-neutral-800 px-1 py-0.5 rounded">with_body</code>, not <code class="text-xs bg-neutral-100 dark:bg-neutral-800 px-1 py-0.5 rounded">with_content</code>: ViewComponent reserves <code class="text-xs bg-neutral-100 dark:bg-neutral-800 px-1 py-0.5 rounded">content</code> for the block itself. It still carries shadcn's <code class="text-xs bg-neutral-100 dark:bg-neutral-800 px-1 py-0.5 rounded">data-slot="card-content"</code>.</li>
  <li>A block that sets no parts renders straight into the card. The card has vertical padding but no horizontal padding, so add <code class="text-xs bg-neutral-100 dark:bg-neutral-800 px-1 py-0.5 rounded">class: "px-6"</code> if you need it.</li>
  <li>The title is a <code class="text-xs bg-neutral-100 dark:bg-neutral-800 px-1 py-0.5 rounded">&lt;div&gt;</code>. For a heading in the document outline, put an <code class="text-xs bg-neutral-100 dark:bg-neutral-800 px-1 py-0.5 rounded">&lt;h2&gt;</code> (or the right level) inside it.</li>
</ul>
