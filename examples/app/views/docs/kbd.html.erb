<% content_for :title, "Kbd" %>
<div class="mb-8">
  <p class="mb-2 text-xs font-semibold uppercase tracking-wider text-violet-600 dark:text-violet-400">Components</p>
  <h1 class="text-3xl font-bold tracking-tight mb-3">Kbd</h1>
  <p class="text-neutral-600 dark:text-neutral-400">
    A single key cap, rendered as a real <code class="text-xs bg-neutral-100 dark:bg-neutral-800 px-1 py-0.5 rounded font-mono">&lt;kbd&gt;</code>.
    <code class="text-xs bg-neutral-100 dark:bg-neutral-800 px-1 py-0.5 rounded font-mono">Ui::Kbd::GroupComponent</code> strings several together for a chord like ⌘K.
  </p>
</div>

<%# Preview %>
<h2 class="text-base font-semibold mb-3">Preview</h2>
<div id="kbd-preview" class="rounded-lg border border-neutral-200 dark:border-neutral-800 bg-neutral-50 dark:bg-neutral-900 flex flex-wrap items-center justify-center gap-8 p-12 mb-8">
  <%= render(Ui::KbdComponent.new) { "K" } %>
  <%= render(Ui::KbdComponent.new) { "Esc" } %>
  <%= render(Ui::KbdComponent.new) { "Enter" } %>
  <%= render Ui::Kbd::GroupComponent.new do |group| %>
    <% group.with_key { "⌘" } %>
    <% group.with_key { "K" } %>
  <% end %>
  <p class="flex items-center gap-1.5 text-sm text-neutral-600 dark:text-neutral-400">
    Press
    <%= render Ui::Kbd::GroupComponent.new do |group| %>
      <% group.with_key { "⇧" } %>
      <% group.with_key { "⌘" } %>
      <% group.with_key { "P" } %>
    <% end %>
    to open the command palette.
  </p>
</div>

<%# Usage %>
<h2 class="text-base font-semibold mb-3">Usage</h2>
<div class="rounded-lg overflow-hidden border border-neutral-800 mb-8">
  <div class="flex items-center justify-between bg-neutral-900 px-4 py-2">
    <span class="text-xs text-neutral-400">ERB</span>
    <button data-copy-target="#kbd-usage" class="text-xs text-neutral-400 hover:text-white transition-colors">Copy</button>
  </div>
  <pre class="bg-neutral-950 px-5 py-4 overflow-x-auto text-sm leading-relaxed"><code id="kbd-usage" class="text-neutral-200"><%= h(example_kbd_usage) %></code></pre>
</div>

<%# Parts %>
<h2 class="text-base font-semibold mb-3">Parts</h2>
<div class="overflow-x-auto rounded-lg border border-neutral-200 dark:border-neutral-800 mb-8">
  <table class="w-full text-sm">
    <thead class="bg-neutral-50 dark:bg-neutral-900">
      <tr>
        <th class="text-left px-4 py-3 text-xs font-semibold text-neutral-500 uppercase tracking-wider">Component</th>
        <th class="text-left px-4 py-3 text-xs font-semibold text-neutral-500 uppercase tracking-wider">data-slot</th>
        <th class="text-left px-4 py-3 text-xs font-semibold text-neutral-500 uppercase tracking-wider">Description</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-neutral-100 dark:divide-neutral-800">
      <% [
        ["Ui::KbdComponent",             "kbd",       "A single key cap. Takes class: and any HTML attribute."],
        ["Ui::Kbd::GroupComponent",      "kbd-group", "Holds a sequence of with_key parts (each a Ui::KbdComponent) in call order, for chords like ⌘K."],
      ].each do |component, data_slot, desc| %>
        <tr class="hover:bg-neutral-50 dark:hover:bg-neutral-900/50">
          <td class="px-4 py-3 font-mono text-xs text-violet-600 dark:text-violet-400"><%= component %></td>
          <td class="px-4 py-3 font-mono text-xs text-neutral-400"><%= data_slot %></td>
          <td class="px-4 py-3 text-neutral-600 dark:text-neutral-400"><%= desc %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<%# Notes %>
<h2 class="text-base font-semibold mb-3">Notes</h2>
<ul class="space-y-2 text-sm text-neutral-600 dark:text-neutral-400 list-disc list-inside">
  <li>Both components take <code class="text-xs bg-neutral-100 dark:bg-neutral-800 px-1 py-0.5 rounded">class:</code>, merged with tailwind_merge so yours wins, plus any other HTML attribute.</li>
  <li>Key cap text reaches 4.5:1 on <code class="text-xs bg-neutral-100 dark:bg-neutral-800 px-1 py-0.5 rounded">--muted</code> in both light and dark mode.</li>
  <li>No Stimulus controller. Kbd is purely presentational text — it doesn't listen for the key it names.</li>
</ul>
