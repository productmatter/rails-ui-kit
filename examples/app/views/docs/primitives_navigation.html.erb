<%
  anchor_usage = <<~HTML
    <div data-controller="ui--anchor"
         data-ui--anchor-placement-value="bottom-start"
         data-ui--anchor-offset-value="8"
         data-ui--anchor-active-value="true">
      <div data-ui--anchor-target="anchor">
        <button type="button">Options</button>
      </div>

      <div data-ui--anchor-target="floating" class="absolute" data-side="bottom" data-align="start">
        Positioned content
        <div data-ui--anchor-target="arrow"></div>
      </div>
    </div>
  HTML

  roving_usage = <<~HTML
    <!-- roving: real DOM focus, one Tab stop -->
    <div role="menu" aria-label="Actions"
         data-controller="ui--roving-focus"
         data-ui--roving-focus-typeahead-value="true">
      <button type="button" role="menuitem" data-ui--roving-focus-target="item">Edit</button>
      <button type="button" role="menuitem" data-ui--roving-focus-target="item">Delete</button>
    </div>

    <!-- activedescendant: focus stays in the input, the option is announced -->
    <div data-controller="ui--roving-focus"
         data-ui--roving-focus-focus-model-value="activedescendant"
         data-ui--roving-focus-active-class="bg-foreground text-background">
      <input type="text" role="combobox" aria-expanded="true" aria-controls="fruit-options"
             data-ui--roving-focus-target="input">
      <ul id="fruit-options" role="listbox" aria-label="Fruit">
        <li role="option" id="fruit-apricot" data-ui--roving-focus-target="item">Apricot</li>
      </ul>
    </div>
  HTML

  placements = %w[top top-start top-end bottom bottom-start bottom-end
                  left left-start left-end right right-start right-end]

  menu_items = [
    { id: 'primitive-menu-edit', label: 'Edit' },
    { id: 'primitive-menu-duplicate', label: 'Duplicate' },
    { id: 'primitive-menu-archive', label: 'Archive', disabled: true },
    { id: 'primitive-menu-delete', label: 'Delete' }
  ]

  fruits = %w[Apricot Apple Blackberry Blueberry Cherry Damson Elderberry]

  floating_classes = 'absolute z-10 whitespace-nowrap rounded-md bg-foreground ' \
                     'px-2 py-1 text-xs font-medium text-background shadow-sm'
  control_classes = 'rounded-md bg-background px-3 py-1.5 text-sm font-medium ' \
                    'border border-border hover:bg-accent ' \
                    'focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring'
  item_classes = 'block w-full text-start rounded px-3 py-1.5 text-sm ' \
                 'hover:bg-accent ' \
                 'focus-visible:outline-2 focus-visible:outline-offset-[-2px] focus-visible:outline-ring ' \
                 'aria-disabled:text-muted-foreground'
  panel_classes = 'rounded-lg border border-border bg-background p-6 mb-8'
%>

<% content_for :title, "Positioning & Navigation" %>
<div class="mb-8">
  <p class="mb-2 text-xs font-semibold uppercase tracking-wider text-primary">Primitives</p>
  <h1 class="text-3xl font-bold tracking-tight mb-3">Positioning &amp; Navigation</h1>
  <p class="text-muted-foreground">
    Two behavior primitives components consume rather than reimplement:
    <code class="text-xs bg-muted px-1 py-0.5 rounded">ui--anchor</code>,
    the kit's only importer of Floating UI, and
    <code class="text-xs bg-muted px-1 py-0.5 rounded">ui--roving-focus</code>,
    group keyboard navigation in both of its focus models. Neither renders markup and neither
    shows or hides anything — every floating element on this page is simply always visible.
  </p>
</div>

<h2 class="text-xl font-semibold tracking-tight mb-2" id="anchor">ui--anchor</h2>
<p class="text-sm text-muted-foreground mb-6">
  Places a floating element against an anchor with flip, shift and offset, publishes the
  <em>resolved</em> side and alignment as <code class="text-xs bg-muted px-1 py-0.5 rounded">data-side</code>
  and <code class="text-xs bg-muted px-1 py-0.5 rounded">data-align</code>,
  and keeps the position current through Floating UI's <code class="text-xs bg-muted px-1 py-0.5 rounded">autoUpdate</code>
  until the element disconnects.
</p>

<h3 class="text-base font-semibold mb-3">Block layout: the control is measured, not the wrapper</h3>
<div class="<%= panel_classes %>" id="anchor-block">
  <div data-controller="ui--anchor"
       data-ui--anchor-placement-value="bottom-end"
       data-ui--anchor-offset-value="6"
       data-ui--anchor-active-value="true">
    <div data-ui--anchor-target="anchor" id="anchor-block-wrapper">
      <button type="button" id="anchor-block-control" class="<%= control_classes %>">Block-layout trigger</button>
    </div>
    <div data-ui--anchor-target="floating" id="anchor-block-floating" class="<%= floating_classes %>">
      bottom-end, aligned to the control
    </div>
  </div>
  <p class="mt-12 text-xs text-muted-foreground">
    The anchor target is a full-width block wrapper; the floating element still lines up with the
    button inside it.
  </p>
</div>

<h3 class="text-base font-semibold mb-3">matchWidth</h3>
<div class="<%= panel_classes %>" id="anchor-match">
  <div data-controller="ui--anchor"
       data-ui--anchor-placement-value="bottom-start"
       data-ui--anchor-match-width-value="true"
       data-ui--anchor-active-value="true">
    <div data-ui--anchor-target="anchor">
      <button type="button" id="anchor-match-control" class="<%= control_classes %>">A wide trigger to match</button>
    </div>
    <div data-ui--anchor-target="floating" id="anchor-match-floating" class="<%= floating_classes %>">
      same width as the control
    </div>
  </div>
  <p class="mt-12 text-xs text-muted-foreground">The select/combobox case.</p>
</div>

<h3 class="text-base font-semibold mb-3">Flex layout</h3>
<div class="<%= panel_classes %> flex items-center justify-between gap-6 pe-40" id="anchor-flex">
  <span class="text-sm text-muted-foreground">A flex row</span>
  <div data-controller="ui--anchor"
       data-ui--anchor-placement-value="right-start"
       data-ui--anchor-active-value="true">
    <button type="button" data-ui--anchor-target="anchor" id="anchor-flex-control" class="<%= control_classes %>">Flex trigger</button>
    <div data-ui--anchor-target="floating" id="anchor-flex-floating" class="<%= floating_classes %>">right-start</div>
  </div>
</div>

<h3 class="text-base font-semibold mb-3">Every placement</h3>
<div class="grid grid-cols-2 sm:grid-cols-3 gap-4 mb-8" id="anchor-placements">
  <% placements.each do |placement| %>
    <div class="relative flex h-24 items-center justify-center rounded-lg border border-border bg-background"
         data-placement-cell="<%= placement %>">
      <div data-controller="ui--anchor"
           data-ui--anchor-placement-value="<%= placement %>"
           data-ui--anchor-offset-value="6"
           data-ui--anchor-flip-value="false"
           data-ui--anchor-active-value="true">
        <span data-ui--anchor-target="anchor" class="inline-block rounded bg-muted px-2 py-1 text-[11px] text-muted-foreground">anchor</span>
        <span data-ui--anchor-target="floating"
              data-requested-placement="<%= placement %>"
              class="absolute z-10 whitespace-nowrap rounded bg-foreground px-1.5 py-0.5 text-[10px] font-medium text-background"><%= placement %></span>
      </div>
    </div>
  <% end %>
</div>
<p class="text-xs text-muted-foreground mb-8">
  Flip is off in this grid so each cell shows the placement it asked for. With flip on — the
  default — the side you get is the side that fit, which is why components style from
  <code class="text-xs bg-muted px-1 py-0.5 rounded">data-side</code>.
</p>

<h3 class="text-base font-semibold mb-3">Flipping, and repositioning on scroll</h3>
<div id="anchor-flip-scroller"
     tabindex="0"
     role="group"
     aria-label="Scrollable region containing an anchored element"
     class="relative h-48 overflow-y-auto rounded-lg border border-border bg-background px-6 mb-8">
  <div class="h-96 pt-4 text-xs text-muted-foreground">
    Keep scrolling inside this box: the label below sits under its control until the room runs
    out, then flips above it.
  </div>
  <div data-controller="ui--anchor"
       data-ui--anchor-placement-value="bottom"
       data-ui--anchor-offset-value="6"
       data-ui--anchor-active-value="true"
       id="anchor-flip">
    <button type="button" data-ui--anchor-target="anchor" id="anchor-flip-control" class="<%= control_classes %>">Scroll this box</button>
    <div data-ui--anchor-target="floating" id="anchor-flip-floating" class="<%= floating_classes %>">
      flips when the side runs out
    </div>
  </div>
  <div class="h-96"></div>
</div>

<h3 class="text-base font-semibold mb-3">An arrow</h3>
<div class="<%= panel_classes %> flex justify-center py-12" id="anchor-arrow">
  <div data-controller="ui--anchor"
       data-ui--anchor-placement-value="top"
       data-ui--anchor-offset-value="10"
       data-ui--anchor-active-value="true">
    <button type="button" data-ui--anchor-target="anchor" id="anchor-arrow-control" class="<%= control_classes %>">Anchor with an arrow</button>
    <div data-ui--anchor-target="floating" id="anchor-arrow-floating" class="<%= floating_classes %>">
      the arrow tracks the control
      <div data-ui--anchor-target="arrow" id="anchor-arrow-arrow" class="absolute h-2 w-2 rotate-45 bg-foreground"></div>
    </div>
  </div>
</div>

<h3 class="text-base font-semibold mb-3">Usage</h3>
<div class="rounded-lg overflow-hidden border border-border mb-8">
  <div class="flex items-center justify-between bg-muted px-4 py-2">
    <span class="text-xs text-muted-foreground">HTML</span>
    <button data-copy-target="#anchor-usage" class="text-xs text-muted-foreground hover:text-foreground transition-colors">Copy</button>
  </div>
  <pre tabindex="0" class="bg-card px-5 py-4 overflow-x-auto text-sm leading-relaxed"><code id="anchor-usage" class="text-card-foreground"><%= h(anchor_usage) %></code></pre>
</div>

<h3 class="text-base font-semibold mb-3">Values</h3>
<div class="overflow-x-auto rounded-lg border border-border mb-12">
  <table class="w-full text-sm">
    <thead class="bg-muted">
      <tr>
        <th class="text-start px-4 py-3 text-xs font-semibold text-muted-foreground uppercase tracking-wider">Name</th>
        <th class="text-start px-4 py-3 text-xs font-semibold text-muted-foreground uppercase tracking-wider">Type</th>
        <th class="text-start px-4 py-3 text-xs font-semibold text-muted-foreground uppercase tracking-wider">Default</th>
        <th class="text-start px-4 py-3 text-xs font-semibold text-muted-foreground uppercase tracking-wider">Description</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-border">
      <% [
        ['placement',    'String',  '"bottom"',   'Any Floating UI placement, e.g. bottom-start.'],
        ['offset',       'Number',  '8',          'Main-axis distance from the anchor, in px.'],
        ['padding',      'Number',  '8',          'Viewport/clipping padding for flip and shift.'],
        ['flip',         'Boolean', 'true',       'Register the flip middleware.'],
        ['shift',        'Boolean', 'true',       'Register the shift middleware.'],
        ['matchWidth',   'Boolean', 'false',      "Set the floating element's width from the anchor's."],
        ['strategy',     'String',  '"absolute"', 'absolute or fixed; fixed once content is portalled.'],
        ['arrowPadding', 'Number',  '4',          "Keeps the arrow off the floating element's corners."],
        ['active',       'Boolean', 'false',      'Positioning and autoUpdate run only while true.']
      ].each do |name, type, default, description| %>
        <tr class="hover:bg-muted/50">
          <td class="px-4 py-3 font-mono text-xs text-primary"><%= name %></td>
          <td class="px-4 py-3 text-muted-foreground"><%= type %></td>
          <td class="px-4 py-3 font-mono text-xs text-muted-foreground"><%= default %></td>
          <td class="px-4 py-3 text-muted-foreground"><%= description %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<h2 class="text-xl font-semibold tracking-tight mb-2" id="roving-focus">ui--roving-focus</h2>
<p class="text-sm text-muted-foreground mb-6">
  Arrow keys, <kbd class="text-xs">Home</kbd>, <kbd class="text-xs">End</kbd> and typeahead over a
  group of items, in one of two focus models. A group declares its model and the controller never
  blends them: <code class="text-xs bg-muted px-1 py-0.5 rounded">roving</code>
  moves real DOM focus and never sets <code class="text-xs bg-muted px-1 py-0.5 rounded">aria-activedescendant</code>;
  <code class="text-xs bg-muted px-1 py-0.5 rounded">activedescendant</code>
  keeps DOM focus in an input and never calls <code class="text-xs bg-muted px-1 py-0.5 rounded">.focus()</code> on an item.
</p>

<h3 class="text-base font-semibold mb-3">roving — menu style</h3>
<div class="<%= panel_classes %>" id="roving-menu">
  <div data-controller="ui--roving-focus"
       data-ui--roving-focus-typeahead-value="true">
    <button type="button"
            id="roving-menu-trigger"
            class="<%= control_classes %> mb-4"
            data-action="keydown.down->ui--roving-focus#focusFirst:prevent keydown.up->ui--roving-focus#focusLast:prevent">
      Tab here, then press ↓ or ↑
    </button>

    <div role="menu" aria-label="Document actions" id="roving-menu-items" class="w-56 rounded-md border border-border bg-popover p-1">
      <% menu_items.each do |item| %>
        <button type="button"
                role="menuitem"
                id="<%= item[:id] %>"
                class="<%= item_classes %>"
                <%= 'aria-disabled="true"'.html_safe if item[:disabled] %>
                data-ui--roving-focus-target="item"
                data-action="mouseenter->ui--roving-focus#activate"><%= item[:label] %></button>
      <% end %>
    </div>
  </div>
  <p class="mt-4 text-xs text-muted-foreground">
    Wrapping arrows, Home and End, typeahead over a 500&thinsp;ms buffer, and one Tab stop: only
    the active item is <code>tabindex="0"</code>. Disabled items follow the APG's menu behaviour,
    which is the default — Archive takes focus so it can be discovered, and is never activated.
  </p>
</div>

<h3 class="text-base font-semibold mb-3">roving — horizontal, no wrap, disabled items skipped</h3>
<div class="<%= panel_classes %>" id="roving-toolbar">
  <div role="toolbar"
       aria-label="Text formatting"
       class="inline-flex gap-1 rounded-md border border-border bg-popover p-1"
       data-controller="ui--roving-focus"
       data-ui--roving-focus-orientation-value="horizontal"
       data-ui--roving-focus-loop-value="false"
       data-ui--roving-focus-skip-disabled-value="true">
    <% [%w[Bold bold], %w[Italic italic], %w[Underline underline], %w[Strike strike]].each_with_index do |(label, id), index| %>
      <button type="button"
              id="roving-toolbar-<%= id %>"
              class="rounded px-3 py-1.5 text-sm hover:bg-accent aria-disabled:text-muted-foreground focus-visible:outline-2 focus-visible:outline-offset-[-2px] focus-visible:outline-ring"
              <%= 'aria-disabled="true"'.html_safe if index == 2 %>
              data-ui--roving-focus-target="item"><%= label %></button>
    <% end %>
  </div>
  <p class="mt-4 text-xs text-muted-foreground">
    ← and → only; ↑ and ↓ are left alone. This group sets <code>skipDisabled: true</code>, so
    Underline is disabled and skipped entirely, and the ends clamp rather than wrap.
  </p>
</div>

<h3 class="text-base font-semibold mb-3">activedescendant — listbox style</h3>
<div class="<%= panel_classes %>" id="roving-listbox">
  <div data-controller="ui--roving-focus"
       data-ui--roving-focus-focus-model-value="activedescendant"
       data-ui--roving-focus-active-class="bg-foreground text-background">
    <label for="roving-listbox-input" class="block text-sm font-medium mb-1">Fruit</label>
    <input type="text"
           id="roving-listbox-input"
           role="combobox"
           aria-expanded="true"
           aria-controls="roving-listbox-options"
           aria-autocomplete="list"
           autocomplete="off"
           placeholder="Type, then press ↓"
           class="w-56 rounded-md border border-input bg-background px-3 py-1.5 text-sm focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
           data-ui--roving-focus-target="input">

    <ul id="roving-listbox-options"
        role="listbox"
        aria-label="Fruit"
        class="mt-2 w-56 max-h-40 overflow-y-auto rounded-md border border-border bg-popover p-1">
      <% fruits.each do |fruit| %>
        <li role="option"
            aria-selected="false"
            id="roving-option-<%= fruit.downcase %>"
            class="cursor-pointer rounded px-3 py-1.5 text-sm"
            data-ui--roving-focus-target="item"
            data-action="click->ui--roving-focus#activate"><%= fruit %></li>
      <% end %>
    </ul>
  </div>
  <p class="mt-4 text-xs text-muted-foreground">
    DOM focus never leaves the text input — typing keeps working while ↑ and ↓ move
    <code>aria-activedescendant</code> and the active class. Home, End and typeahead stay with the
    input, because it is editable and those are its own keys.
  </p>
</div>

<h3 class="text-base font-semibold mb-3">Usage</h3>
<div class="rounded-lg overflow-hidden border border-border mb-8">
  <div class="flex items-center justify-between bg-muted px-4 py-2">
    <span class="text-xs text-muted-foreground">HTML</span>
    <button data-copy-target="#roving-usage" class="text-xs text-muted-foreground hover:text-foreground transition-colors">Copy</button>
  </div>
  <pre tabindex="0" class="bg-card px-5 py-4 overflow-x-auto text-sm leading-relaxed"><code id="roving-usage" class="text-card-foreground"><%= h(roving_usage) %></code></pre>
</div>

<h3 class="text-base font-semibold mb-3">Values</h3>
<div class="overflow-x-auto rounded-lg border border-border mb-8">
  <table class="w-full text-sm">
    <thead class="bg-muted">
      <tr>
        <th class="text-start px-4 py-3 text-xs font-semibold text-muted-foreground uppercase tracking-wider">Name</th>
        <th class="text-start px-4 py-3 text-xs font-semibold text-muted-foreground uppercase tracking-wider">Type</th>
        <th class="text-start px-4 py-3 text-xs font-semibold text-muted-foreground uppercase tracking-wider">Default</th>
        <th class="text-start px-4 py-3 text-xs font-semibold text-muted-foreground uppercase tracking-wider">Description</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-border">
      <% [
        ['focusModel',       'String',  '"roving"',     'roving or activedescendant.'],
        ['orientation',      'String',  '"vertical"',   'vertical, horizontal or both.'],
        ['loop',             'Boolean', 'true',         'Wrap at the ends; false clamps.'],
        ['typeahead',        'Boolean', 'false',        'First-letter matching, aria-label ahead of text.'],
        ['typeaheadTimeout', 'Number',  '500',          'ms of idle before the typed buffer resets.'],
        ['activeId',         'String',  '""',           "DOM id of the active item; the group's single source of truth."],
        ['skipDisabled',     'Boolean', 'false',        'Disabled items stay navigable but are never activated (APG menus); true leaves them out of navigation, Home, End and typeahead.'],
        ['pageStep',         'Number',  '0',            'PageDown and PageUp move this many items, stopping at the first or last. 0 leaves both keys alone. A select-only combobox uses 10.']
      ].each do |name, type, default, description| %>
        <tr class="hover:bg-muted/50">
          <td class="px-4 py-3 font-mono text-xs text-primary"><%= name %></td>
          <td class="px-4 py-3 text-muted-foreground"><%= type %></td>
          <td class="px-4 py-3 font-mono text-xs text-muted-foreground"><%= default %></td>
          <td class="px-4 py-3 text-muted-foreground"><%= description %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<h3 class="text-base font-semibold mb-3">Targets, classes and events</h3>
<ul class="text-sm text-muted-foreground space-y-2 mb-8 list-disc ps-5">
  <li><strong>Targets.</strong> <code>anchor</code>, <code>floating</code> and an optional <code>arrow</code> for <code>ui--anchor</code>; <code>item</code>, and <code>input</code> in activedescendant mode, for <code>ui--roving-focus</code>.</li>
  <li><strong>Classes.</strong> <code>ui--roving-focus</code> declares one, <code>active</code>, applied to the active item in activedescendant mode — where no item has DOM focus, so <code>:focus-visible</code> cannot style it.</li>
  <li><strong>Events.</strong> <code>ui--anchor:positioned</code> with <code>{ x, y, placement, side, align }</code>, and <code>ui--roving-focus:activated</code> with <code>{ item, id, index }</code>.</li>
  <li><strong>Actions.</strong> <code>focusFirst</code>, <code>focusLast</code> and <code>activate</code> — enough for a trigger to open a menu onto either end, and for hover and click to keep the active item in step.</li>
  <li><strong>Composition.</strong> A component drives <code>ui--anchor</code> through a Stimulus outlet by setting <code>activeValue</code>; it never imports Floating UI itself.</li>
</ul>
