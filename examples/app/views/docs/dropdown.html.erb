<% content_for :title, "Dropdown" %>
<div class="mb-8">
  <p class="mb-2 text-xs font-semibold uppercase tracking-wider text-primary">Overlays</p>
  <h1 class="text-3xl font-bold tracking-tight mb-3">Dropdown</h1>
  <p class="text-muted-foreground">
    The actions for a record, behind one button: Edit, Duplicate, a <code class="text-xs bg-muted px-1 py-0.5 rounded font-mono">button_to</code> Delete with its
    <code class="text-xs bg-muted px-1 py-0.5 rounded font-mono">data-turbo-confirm</code>. <code class="text-xs bg-muted px-1 py-0.5 rounded font-mono">kind: :menu</code> follows the WAI-ARIA menu button pattern — arrow keys,
    Home/End, typeahead, Escape — and works on the links and buttons Rails renders, including content Turbo swaps in later.
    <code class="text-xs bg-muted px-1 py-0.5 rounded font-mono">kind: :dialog</code> holds a small form instead, such as a filter. Both are anchored to their trigger and stay on
    screen.
  </p>
</div>

<%# Preview %>
<h2 class="text-base font-semibold mb-3">Preview</h2>
<div class="rounded-lg border border-border bg-background flex flex-wrap items-start justify-center gap-6 p-12 mb-8">
  <%# Menu %>
  <%= render Ui::DropdownComponent.new(kind: :menu, placement: :bottom_start) do |d| %>
    <% d.with_trigger do %>
      <button class="flex items-center gap-1.5 rounded-md border border-input bg-background px-3 py-1.5 text-sm font-medium hover:bg-accent hover:text-accent-foreground transition-colors">
        Menu
        <svg class="h-3 w-3" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 4l4 4 4-4"/></svg>
      </button>
    <% end %>
    <% d.with_panel do %>
      <div class="py-1 min-w-[10rem]">
        <a href="#" role="menuitem" class="flex px-3 py-2 text-sm text-popover-foreground hover:bg-accent hover:text-accent-foreground focus:bg-accent focus:text-accent-foreground">Edit</a>
        <a href="#" role="menuitem" class="flex px-3 py-2 text-sm text-popover-foreground hover:bg-accent hover:text-accent-foreground focus:bg-accent focus:text-accent-foreground">Duplicate</a>
        <a href="#" role="menuitem" aria-disabled="true" class="flex px-3 py-2 text-sm text-muted-foreground cursor-default">Archive</a>
        <a href="#" role="menuitem" class="flex px-3 py-2 text-sm text-destructive hover:bg-accent focus:bg-accent">Delete</a>
      </div>
    <% end %>
  <% end %>

  <%# Dialog %>
  <%= render Ui::DropdownComponent.new(kind: :dialog, label: "Filter", placement: :bottom_start) do |d| %>
    <% d.with_trigger do %>
      <button class="flex items-center gap-1.5 rounded-md border border-input bg-background px-3 py-1.5 text-sm font-medium hover:bg-accent hover:text-accent-foreground transition-colors">
        Dialog
        <svg class="h-3 w-3" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 4l4 4 4-4"/></svg>
      </button>
    <% end %>
    <% d.with_panel do %>
      <label class="block w-56 p-3 text-sm">
        <span class="mb-1.5 block font-medium">Name contains</span>
        <input type="text" class="w-full rounded-md border border-input bg-background px-2 py-1.5 text-sm">
      </label>
    <% end %>
  <% end %>
</div>

<%# Usage %>
<h2 class="text-base font-semibold mb-3">Usage</h2>
<div class="rounded-lg overflow-hidden border border-border mb-8">
  <div class="flex items-center justify-between bg-muted px-4 py-2">
    <span class="text-xs text-muted-foreground">ERB</span>
    <button data-copy-target="#dropdown-usage" class="text-xs text-muted-foreground hover:text-foreground transition-colors">Copy</button>
  </div>
  <pre class="bg-card px-5 py-4 overflow-x-auto text-sm leading-relaxed"><code id="dropdown-usage" class="text-card-foreground"><%= h(example_dropdown_usage) %></code></pre>
</div>

<%# Options %>
<h2 class="text-base font-semibold mb-3">Options</h2>
<div class="overflow-x-auto rounded-lg border border-border mb-8">
  <table class="w-full text-sm">
    <thead class="bg-muted">
      <tr>
        <th class="text-start px-4 py-3 text-xs font-semibold text-muted-foreground uppercase tracking-wider">Name</th>
        <th class="text-start px-4 py-3 text-xs font-semibold text-muted-foreground uppercase tracking-wider">Type</th>
        <th class="text-start px-4 py-3 text-xs font-semibold text-muted-foreground uppercase tracking-wider">Default</th>
        <th class="text-start px-4 py-3 text-xs font-semibold text-muted-foreground uppercase tracking-wider">Description</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-border">
      <% [
        ["kind",           "Symbol",  ":menu",         "Interaction mode: :menu (the menu button pattern — see Keyboard below), :dialog (focus moves to the first field on open)."],
        ["placement",      "String or Symbol", '"bottom-start"', "One of the 12 placements: top, top-start, … right-end. :bottom_start works as well as \"bottom-start\"."],
        ["offset",         "Integer", "4",             "Gap between trigger and content in pixels."],
        ["match_width",    "Boolean", "false",          "Makes the dropdown match the trigger's width."],
        ["label",          "String",  "nil",           "Accessible name for the floating content. Give every :dialog one."],
        ["class",          "String",  "nil",           "Merged onto the dropdown's root element, which wraps the trigger. Style the panel through the panel slot's class: instead."],
        ["content_classes","String",  "nil",           "Deprecated: pass the classes to with_panel(class:), which merges them the same way. Removed in 0.4.0."],
      ].each do |name, type, default, desc| %>
        <tr class="hover:bg-muted/50">
          <td class="px-4 py-3 font-mono text-xs text-primary"><%= name %></td>
          <td class="px-4 py-3 text-muted-foreground"><%= type %></td>
          <td class="px-4 py-3 font-mono text-xs text-muted-foreground"><%= default %></td>
          <td class="px-4 py-3 text-muted-foreground"><%= desc %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<%# Accessibility %>
<h2 class="text-base font-semibold mb-3">Accessibility</h2>
<p class="text-sm text-muted-foreground mb-3">
  <code class="text-xs bg-muted px-1.5 py-0.5 rounded font-mono">kind: :menu</code>
  implements the <a class="text-primary underline" href="https://www.w3.org/WAI/ARIA/apg/patterns/menu-button/">WAI-ARIA menu button pattern</a>.
</p>
<div class="overflow-x-auto rounded-lg border border-border mb-4">
  <table class="w-full text-sm">
    <thead class="bg-muted">
      <tr>
        <th class="text-start px-4 py-3 text-xs font-semibold text-muted-foreground uppercase tracking-wider">Key</th>
        <th class="text-start px-4 py-3 text-xs font-semibold text-muted-foreground uppercase tracking-wider">On the trigger</th>
        <th class="text-start px-4 py-3 text-xs font-semibold text-muted-foreground uppercase tracking-wider">In the open menu</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-border">
      <% [
        ["Enter / Space", "Opens the menu on the first item.", "Activates the focused item and closes the menu."],
        ["↓",             "Opens the menu on the first item.", "Moves to the next item, wrapping to the first."],
        ["↑",             "Opens the menu on the last item.",  "Moves to the previous item, wrapping to the last."],
        ["Home / End",    "—",                                 "Moves to the first or last item."],
        ["A–Z, 0–9",      "—",                                 "Moves to the next item whose label starts with what you type (500ms buffer)."],
        ["Esc",           "—",                                 "Closes the menu and returns focus to the trigger."],
        ["Tab",           "Moves on to the next control.",     "Closes the menu; focus continues past it."],
      ].each do |key, on_trigger, in_menu| %>
        <tr class="hover:bg-muted/50">
          <td class="px-4 py-3 font-mono text-xs text-primary whitespace-nowrap"><%= key %></td>
          <td class="px-4 py-3 text-muted-foreground"><%= on_trigger %></td>
          <td class="px-4 py-3 text-muted-foreground"><%= in_menu %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
<div class="rounded-lg border border-border p-4 mb-8 text-sm text-muted-foreground space-y-3">
  <p>
    The menu is a single tab stop, navigated by <code class="text-xs bg-muted px-1 py-0.5 rounded">ui--roving-focus</code>:
    the focused item carries <code class="text-xs bg-muted px-1 py-0.5 rounded">tabindex="0"</code>
    and every other item <code class="text-xs bg-muted px-1 py-0.5 rounded">tabindex="-1"</code>,
    so Tab moves past the whole menu rather than through its items. Closed, no item is rendered, so the trigger is the only stop.
  </p>
  <p>
    Items don't have to carry roles. If the panel slot contains no
    <code class="text-xs bg-muted px-1 py-0.5 rounded">menuitem</code>,
    <code class="text-xs bg-muted px-1 py-0.5 rounded">menuitemcheckbox</code> or
    <code class="text-xs bg-muted px-1 py-0.5 rounded">menuitemradio</code>, its links and enabled buttons
    become the items and are given <code class="text-xs bg-muted px-1 py-0.5 rounded">role="menuitem"</code> —
    so ordinary markup, including content swapped in later by Turbo, navigates like a menu. Writing the roles yourself stays the clearer option.
  </p>
  <p>
    Mark an unavailable item <code class="text-xs bg-muted px-1 py-0.5 rounded">aria-disabled="true"</code>
    (as Archive is above) rather than hiding it. It still takes focus from the arrows and typeahead, so users can
    discover it, but Enter, Space and clicks don't choose it and a disabled link doesn't navigate.
  </p>
  <p>
    <code class="text-xs bg-muted px-1.5 py-0.5 rounded font-mono">:dialog</code> doesn't follow this pattern:
    it moves focus to its first field and leaves Tab to the browser.
  </p>
</div>

<%# Slots %>
<h2 class="text-base font-semibold mb-3">Slots</h2>
<div class="overflow-x-auto rounded-lg border border-border mb-8">
  <table class="w-full text-sm">
    <thead class="bg-muted">
      <tr>
        <th class="text-start px-4 py-3 text-xs font-semibold text-muted-foreground uppercase tracking-wider">Name</th>
        <th class="text-start px-4 py-3 text-xs font-semibold text-muted-foreground uppercase tracking-wider">Description</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-border">
      <tr>
        <td class="px-4 py-3 font-mono text-xs text-primary">trigger</td>
        <td class="px-4 py-3 text-muted-foreground">The button that opens the dropdown. Dropdown binds it itself; nothing to wire.</td>
      </tr>
      <tr>
        <td class="px-4 py-3 font-mono text-xs text-primary">panel</td>
        <td class="px-4 py-3 text-muted-foreground">The floating content. Render items with the appropriate role (<code class="text-xs bg-muted px-1 py-0.5 rounded">menuitem</code>). A <code class="text-xs bg-muted px-1 py-0.5 rounded">:menu</code> written as plain links and buttons works too — see Keyboard. <code class="text-xs bg-muted px-1 py-0.5 rounded font-mono">with_panel(class: "min-w-48")</code> merges classes over the panel's own. The slot was called <code class="text-xs bg-muted px-1 py-0.5 rounded font-mono">menu</code> in 0.2.0; <code class="text-xs bg-muted px-1 py-0.5 rounded font-mono">with_menu</code> still works, with a deprecation warning, until 0.4.0.</td>
      </tr>
    </tbody>
  </table>
</div>

<%# Not this %>
<h2 class="text-base font-semibold mb-3">When not to use it</h2>
<p class="text-sm text-muted-foreground mb-8">
  Picking a value for a form is a <%= link_to "Select", select_path, class: "text-primary underline" %>, not a menu: a menu runs
  actions, a select posts a value. Site navigation is a list of links, not <code class="text-xs bg-muted px-1 py-0.5 rounded font-mono">role="menu"</code>, which changes how screen
  readers and the keyboard treat every item. Rich content that isn't a list of actions is a
  <%= link_to "Popover", popover_path, class: "text-primary underline" %>.
</p>
