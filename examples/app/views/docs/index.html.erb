<% content_for :title, "Introduction" %>

<div class="mb-10">
  <p class="mb-2 text-xs font-semibold uppercase tracking-wider text-primary">Getting Started</p>
  <h1 class="text-3xl font-bold tracking-tight mb-3">rails-ui-kit</h1>
  <p class="text-lg text-muted-foreground leading-relaxed">
    A private ViewComponent + Stimulus kit for Rails apps. Every component here either plugs into
    Rails and Turbo — form errors, Streams, the page cache — or handles browser behaviour that is
    hard to get right: focus, anchored positioning, keyboard models and exit animations. Anything
    that is just markup with classes is deliberately not here.
  </p>
</div>

<%# Both lists come from DocsPages::PAGES, the same registry the sidebar and routes use, so a
    new page appears here automatically and can't be forgotten. %>
<% [["Components", "Components"], ["Utilities", "Utility Controllers"]].each do |section, heading| %>
  <div class="rounded-lg border border-border divide-y divide-border mb-12">
    <div class="px-5 py-3 bg-muted rounded-t-lg">
      <p class="text-xs font-semibold uppercase tracking-wider text-muted-foreground"><%= heading %></p>
    </div>
    <% DocsPages.in_section(section).each do |page| %>
      <% path = send("#{page[:slug]}_path") %>
      <div class="flex items-start gap-4 px-5 py-4">
        <div class="flex-1">
          <%= link_to page[:title], path, class: "font-medium text-sm hover:text-primary transition-colors" %>
          <p class="text-sm text-muted-foreground mt-0.5"><%= page[:summary] %></p>
        </div>
        <%= link_to "→", path, class: "text-muted-foreground hover:text-foreground text-sm mt-0.5", "aria-hidden": true, tabindex: -1 %>
      </div>
    <% end %>
  </div>
<% end %>

<div class="flex gap-3">
  <%= render Ui::ButtonComponent.new(href: installation_path) do %>
    Get started →
  <% end %>
  <%= render Ui::ButtonComponent.new(href: "https://github.com/productmatter/rails-ui-kit",
                                     variant: :outline, target: "_blank", rel: "noopener") do %>
    View on GitHub
  <% end %>
</div>
