<% content_for :title, "Native Select" %>
<div class="mb-8">
  <p class="mb-2 text-xs font-semibold uppercase tracking-wider text-violet-600 dark:text-violet-400">Components</p>
  <h1 class="text-3xl font-bold tracking-tight mb-3">Native Select</h1>
  <p class="text-neutral-600 dark:text-neutral-400">
    A native <code class="text-xs bg-neutral-100 dark:bg-neutral-800 px-1 py-0.5 rounded font-mono">&lt;select&gt;</code>
    styled as a form control, with a decorative chevron. Options and optgroups take
    <code class="text-xs bg-neutral-100 dark:bg-neutral-800 px-1 py-0.5 rounded font-mono">bg-popover text-popover-foreground</code>
    automatically -- no class on the option itself.
  </p>
</div>

<%# Preview %>
<h2 class="text-base font-semibold mb-3">Preview</h2>
<div id="native_select-preview" class="rounded-lg border border-neutral-200 dark:border-neutral-800 bg-neutral-50 dark:bg-neutral-900 flex flex-wrap items-start gap-6 p-12 mb-8">
  <div class="grid gap-2 w-56">
    <%= render(Ui::LabelComponent.new(for: "default-select", class: "text-xs font-mono text-neutral-600 dark:text-neutral-400")) { "default" } %>
    <%= render Ui::NativeSelectComponent.new(id: "default-select", name: "default") do %>
      <option value="member">Member</option>
      <option value="admin">Admin</option>
    <% end %>
  </div>
  <div class="grid gap-2 w-56">
    <%= render(Ui::LabelComponent.new(for: "sm-select", class: "text-xs font-mono text-neutral-600 dark:text-neutral-400")) { "size: sm" } %>
    <%= render Ui::NativeSelectComponent.new(id: "sm-select", name: "sm", size: :sm) do %>
      <option value="s">Small</option>
      <option value="m">Medium</option>
      <option value="l">Large</option>
    <% end %>
  </div>
  <div class="grid gap-2 w-56">
    <%= render(Ui::LabelComponent.new(for: "focused-select", class: "text-xs font-mono text-neutral-600 dark:text-neutral-400")) { "focus (tab to me)" } %>
    <%= render Ui::NativeSelectComponent.new(id: "focused-select", name: "focused") do %>
      <option>Tab to me</option>
    <% end %>
  </div>
  <div class="grid gap-2 w-56">
    <%= render(Ui::LabelComponent.new(for: "invalid-select", class: "text-xs font-mono text-neutral-600 dark:text-neutral-400")) { "invalid" } %>
    <%= render Ui::NativeSelectComponent.new(id: "invalid-select", name: "invalid", aria: { invalid: true }) do %>
      <option value="">Choose a role</option>
      <option value="member">Member</option>
    <% end %>
  </div>
  <div class="grid gap-2 w-56">
    <%= render(Ui::LabelComponent.new(for: "disabled-select", class: "text-xs font-mono text-neutral-600 dark:text-neutral-400")) { "disabled" } %>
    <%= render Ui::NativeSelectComponent.new(id: "disabled-select", name: "disabled", disabled: true) do %>
      <option>Can't touch this</option>
    <% end %>
  </div>
  <div class="grid gap-2 w-56">
    <%= render(Ui::LabelComponent.new(for: "optgroup-select", class: "text-xs font-mono text-neutral-600 dark:text-neutral-400")) { "optgroup" } %>
    <%= render Ui::NativeSelectComponent.new(id: "optgroup-select", name: "region") do %>
      <optgroup label="Americas">
        <option value="us">United States</option>
        <option value="br">Brazil</option>
      </optgroup>
      <optgroup label="Europe">
        <option value="fr">France</option>
        <option value="de">Germany</option>
      </optgroup>
    <% end %>
  </div>
</div>
<p class="text-sm text-neutral-600 dark:text-neutral-400 mb-8">
  Tab to the "focused" field to see the focus ring — an offset outline drawn from the
  <code class="text-xs bg-neutral-100 dark:bg-neutral-800 px-1 py-0.5 rounded font-mono">--ring</code> token, the same idiom Button and Input use.
  Open any select to see its options in <code class="text-xs bg-neutral-100 dark:bg-neutral-800 px-1 py-0.5 rounded font-mono">--popover</code> colours.
</p>

<%# Usage %>
<h2 class="text-base font-semibold mb-3">Usage</h2>
<div class="rounded-lg overflow-hidden border border-neutral-800 mb-8">
  <div class="flex items-center justify-between bg-neutral-900 px-4 py-2">
    <span class="text-xs text-neutral-400">ERB</span>
    <button data-copy-target="#native_select-usage" class="text-xs text-neutral-400 hover:text-white transition-colors">Copy</button>
  </div>
  <pre class="bg-neutral-950 px-5 py-4 overflow-x-auto text-sm leading-relaxed"><code id="native_select-usage" class="text-neutral-200"><%= h(example_native_select_usage) %></code></pre>
</div>

<%# Options %>
<h2 class="text-base font-semibold mb-3">Options</h2>
<div class="overflow-x-auto rounded-lg border border-neutral-200 dark:border-neutral-800 mb-8">
  <table class="w-full text-sm">
    <thead class="bg-neutral-50 dark:bg-neutral-900">
      <tr>
        <th class="text-left px-4 py-3 text-xs font-semibold text-neutral-500 uppercase tracking-wider">Name</th>
        <th class="text-left px-4 py-3 text-xs font-semibold text-neutral-500 uppercase tracking-wider">Type</th>
        <th class="text-left px-4 py-3 text-xs font-semibold text-neutral-500 uppercase tracking-wider">Default</th>
        <th class="text-left px-4 py-3 text-xs font-semibold text-neutral-500 uppercase tracking-wider">Description</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-neutral-100 dark:divide-neutral-800">
      <% [
        ["size",         "default, sm", '"default"', "Height and horizontal padding. The chevron stays a fixed size either way."],
        ["class",        "String",      "nil",       "Merged over the default classes with tailwind_merge — the caller always wins."],
        ["aria-invalid", "Boolean",     "nil",        "Set aria: { invalid: true } to draw the invalid boundary and focus colour. Not a keyword, so field binding can set it later."],
        ["disabled",     "Boolean",     "nil",        "Forwarded straight to the native disabled attribute."],
        ["…",            "Any",         "—",          "Every other keyword (id:, name:, multiple:, data:, aria:, …) is forwarded to the select element. The block is its options/optgroups."],
      ].each do |name, type, default, desc| %>
        <tr class="hover:bg-neutral-50 dark:hover:bg-neutral-900/50">
          <td class="px-4 py-3 font-mono text-xs text-violet-600 dark:text-violet-400"><%= name %></td>
          <td class="px-4 py-3 text-neutral-500"><%= type %></td>
          <td class="px-4 py-3 font-mono text-xs text-neutral-400"><%= default %></td>
          <td class="px-4 py-3 text-neutral-600 dark:text-neutral-400"><%= desc %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<%# Notes %>
<h2 class="text-base font-semibold mb-3">Notes</h2>
<ul class="space-y-2 text-sm text-neutral-600 dark:text-neutral-400 list-disc list-inside">
  <li>The chevron is a decorative <code class="text-xs bg-neutral-100 dark:bg-neutral-800 px-1 py-0.5 rounded">&lt;svg aria-hidden="true"&gt;</code> in a plain positioning wrapper, not a caller-facing part — the <code class="text-xs bg-neutral-100 dark:bg-neutral-800 px-1 py-0.5 rounded">&lt;select&gt;</code> itself is the root, so id/name/disabled/aria-invalid forward exactly as Input's do.</li>
  <li>A native <code class="text-xs bg-neutral-100 dark:bg-neutral-800 px-1 py-0.5 rounded">&lt;option&gt;</code> can't inherit the select's own classes, so the popover colours reach every option and optgroup through a descendant selector on the select — no class needed on the option tags themselves.</li>
  <li>The fill and boundary follow the same rule as Input: transparent in light mode, a translucent <code class="text-xs bg-neutral-100 dark:bg-neutral-800 px-1 py-0.5 rounded">--muted</code> tint in dark, boundary from <code class="text-xs bg-neutral-100 dark:bg-neutral-800 px-1 py-0.5 rounded">--input</code>.</li>
  <li>No Stimulus controller. Pair it with <code class="text-xs bg-neutral-100 dark:bg-neutral-800 px-1 py-0.5 rounded">Ui::LabelComponent</code> for the field's name.</li>
</ul>
