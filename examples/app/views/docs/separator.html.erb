<% content_for :title, "Separator" %>
<div class="mb-8">
  <p class="mb-2 text-xs font-semibold uppercase tracking-wider text-violet-600 dark:text-violet-400">Components</p>
  <h1 class="text-3xl font-bold tracking-tight mb-3">Separator</h1>
  <p class="text-neutral-600 dark:text-neutral-400">
    A rule between content, drawn from the
    <code class="text-xs bg-neutral-100 dark:bg-neutral-800 px-1 py-0.5 rounded font-mono">--border</code> token.
    Decorative by default; pass <code class="text-xs bg-neutral-100 dark:bg-neutral-800 px-1 py-0.5 rounded font-mono">decorative: false</code>
    when the division itself is meaningful.
  </p>
</div>

<div id="separator-preview">
  <%# Horizontal %>
  <h2 class="text-base font-semibold mb-3">Horizontal</h2>
  <div class="rounded-lg border border-neutral-200 dark:border-neutral-800 bg-neutral-50 dark:bg-neutral-900 p-8 mb-8">
    <div class="text-sm">
      <p class="font-medium">Rails UI Kit</p>
      <p class="text-neutral-600 dark:text-neutral-400">Presentational components for Rails.</p>
    </div>
    <%= render(Ui::SeparatorComponent.new(class: "my-4")) %>
    <div class="flex h-5 items-center gap-4 text-sm">
      <span>Blog</span>
      <%= render Ui::SeparatorComponent.new(orientation: :vertical) %>
      <span>Docs</span>
      <%= render Ui::SeparatorComponent.new(orientation: :vertical) %>
      <span>Source</span>
    </div>
  </div>

  <%# Orientation %>
  <h2 class="text-base font-semibold mb-3">Orientation</h2>
  <div class="rounded-lg border border-neutral-200 dark:border-neutral-800 divide-y divide-neutral-100 dark:divide-neutral-800 mb-8">
    <div class="flex items-center gap-6 px-5 py-4">
      <div class="w-40 shrink-0"><%= render(Ui::SeparatorComponent.new) %></div>
      <div>
        <p class="font-mono text-xs text-violet-600 dark:text-violet-400 mb-0.5">orientation: :horizontal</p>
        <p class="text-sm text-neutral-600 dark:text-neutral-400">The default. Spans the width of its container.</p>
      </div>
    </div>
    <div class="flex items-center gap-6 px-5 py-4">
      <div class="w-40 h-8 shrink-0 flex"><%= render(Ui::SeparatorComponent.new(orientation: :vertical)) %></div>
      <div>
        <p class="font-mono text-xs text-violet-600 dark:text-violet-400 mb-0.5">orientation: :vertical</p>
        <p class="text-sm text-neutral-600 dark:text-neutral-400">Spans the height of its container -- give the container a height.</p>
      </div>
    </div>
  </div>

  <%# Decorative vs semantic %>
  <h2 class="text-base font-semibold mb-3">Decorative vs. semantic</h2>
  <div class="rounded-lg border border-neutral-200 dark:border-neutral-800 bg-neutral-50 dark:bg-neutral-900 p-8 mb-4 space-y-4">
    <div>
      <p class="text-sm mb-2">Decorative (default) -- <code class="text-xs bg-neutral-100 dark:bg-neutral-800 px-1 py-0.5 rounded">role="none"</code></p>
      <%= render(Ui::SeparatorComponent.new) %>
    </div>
    <div>
      <p class="text-sm mb-2">Semantic -- <code class="text-xs bg-neutral-100 dark:bg-neutral-800 px-1 py-0.5 rounded">role="separator"</code>, <code class="text-xs bg-neutral-100 dark:bg-neutral-800 px-1 py-0.5 rounded">aria-orientation="horizontal"</code></p>
      <%= render(Ui::SeparatorComponent.new(decorative: false)) %>
    </div>
  </div>
</div>

<%# Usage %>
<h2 class="text-base font-semibold mb-3">Usage</h2>
<div class="rounded-lg overflow-hidden border border-neutral-800 mb-8">
  <div class="flex items-center justify-between bg-neutral-900 px-4 py-2">
    <span class="text-xs text-neutral-400">ERB</span>
    <button data-copy-target="#separator-usage" class="text-xs text-neutral-400 hover:text-white transition-colors">Copy</button>
  </div>
  <pre class="bg-neutral-950 px-5 py-4 overflow-x-auto text-sm leading-relaxed"><code id="separator-usage" class="text-neutral-200"><%= h(example_separator_usage) %></code></pre>
</div>

<%# Options %>
<h2 class="text-base font-semibold mb-3">Options</h2>
<div class="overflow-x-auto rounded-lg border border-neutral-200 dark:border-neutral-800 mb-8">
  <table class="w-full text-sm">
    <thead class="bg-neutral-50 dark:bg-neutral-900">
      <tr>
        <th class="text-left px-4 py-3 text-xs font-semibold text-neutral-500 uppercase tracking-wider">Name</th>
        <th class="text-left px-4 py-3 text-xs font-semibold text-neutral-500 uppercase tracking-wider">Type</th>
        <th class="text-left px-4 py-3 text-xs font-semibold text-neutral-500 uppercase tracking-wider">Default</th>
        <th class="text-left px-4 py-3 text-xs font-semibold text-neutral-500 uppercase tracking-wider">Description</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-neutral-100 dark:divide-neutral-800">
      <% [
        ["orientation", "Symbol",  ":horizontal", "One of :horizontal, :vertical."],
        ["decorative",  "Boolean", "true",        "false renders role=\"separator\" and aria-orientation instead of role=\"none\"."],
        ["class",       "String",  "nil",         "Merged over the variant classes with tailwind_merge -- the caller always wins."],
        ["…",           "Any",     "—",           "Every other keyword (id:, data:, aria:, …) is forwarded to the root element."],
      ].each do |name, type, default, desc| %>
        <tr class="hover:bg-neutral-50 dark:hover:bg-neutral-900/50">
          <td class="px-4 py-3 font-mono text-xs text-violet-600 dark:text-violet-400"><%= name %></td>
          <td class="px-4 py-3 text-neutral-500"><%= type %></td>
          <td class="px-4 py-3 font-mono text-xs text-neutral-400"><%= default %></td>
          <td class="px-4 py-3 text-neutral-600 dark:text-neutral-400"><%= desc %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<%# Notes %>
<h2 class="text-base font-semibold mb-3">Notes</h2>
<ul class="space-y-2 text-sm text-neutral-600 dark:text-neutral-400 list-disc list-inside">
  <li>No Stimulus controller. Separator is pure decoration or semantics, never behaviour.</li>
  <li>The root element carries <code class="text-xs bg-neutral-100 dark:bg-neutral-800 px-1 py-0.5 rounded">data-slot="separator"</code> as a styling and testing hook that survives class changes.</li>
  <li>A vertical separator needs a container with an explicit height -- it fills 100% of its parent, and a parent with no height collapses to zero.</li>
  <li>Exempt from the kit's 3:1 non-text contrast rule: it's decoration, like a card border, not a control boundary.</li>
</ul>
