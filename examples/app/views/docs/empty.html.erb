<% content_for :title, "Empty" %>
<div class="mb-8">
  <p class="mb-2 text-xs font-semibold uppercase tracking-wider text-primary">Components</p>
  <h1 class="text-3xl font-bold tracking-tight mb-3">Empty</h1>
  <p class="text-muted-foreground">
    An empty state: a header (media, title, description), then a body for actions -- in that fixed
    order. <code class="text-xs bg-neutral-100 dark:bg-neutral-800 px-1 py-0.5 rounded font-mono">content</code> is
    ViewComponent's block, so the shadcn Content part is <code class="text-xs bg-neutral-100 dark:bg-neutral-800 px-1 py-0.5 rounded font-mono">with_body</code> here;
    its class and <code class="text-xs bg-neutral-100 dark:bg-neutral-800 px-1 py-0.5 rounded font-mono">data-slot</code> keep the name <code class="text-xs bg-neutral-100 dark:bg-neutral-800 px-1 py-0.5 rounded font-mono">content</code>.
  </p>
</div>

<div id="empty-preview">
  <%# Preview %>
  <h2 class="text-base font-semibold mb-3">Preview</h2>
  <div class="rounded-lg border border-border bg-muted p-8 mb-8">
    <%= render Ui::EmptyComponent.new do |empty| %>
      <% empty.with_header do |header| %>
        <% header.with_media(variant: :icon) do %>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
        <% end %>
        <% header.with_title { "No results found" } %>
        <% header.with_description { "Try adjusting your search or filters, or clear them to start over." } %>
      <% end %>
      <% empty.with_body do %>
        <div class="flex gap-2">
          <%= render(Ui::ButtonComponent.new(variant: :outline)) { "Clear filters" } %>
          <%= render(Ui::ButtonComponent.new) { "New search" } %>
        </div>
      <% end %>
    <% end %>
  </div>

  <%# Media variants %>
  <h2 class="text-base font-semibold mb-3">Media variants</h2>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
    <div class="rounded-lg border border-border bg-muted p-8">
      <%= render Ui::EmptyComponent.new(class: "p-0") do |empty| %>
        <% empty.with_header do |header| %>
          <% header.with_media do %>
            <svg viewBox="0 0 24 24" width="40" height="40" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="4" y="4" width="16" height="16" rx="2"/></svg>
          <% end %>
          <% header.with_title { "media variant: :default" } %>
          <% header.with_description { "Transparent, no background of its own." } %>
        <% end %>
      <% end %>
    </div>
    <div class="rounded-lg border border-border bg-muted p-8">
      <%= render Ui::EmptyComponent.new(class: "p-0") do |empty| %>
        <% empty.with_header do |header| %>
          <% header.with_media(variant: :icon) do %>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="4" y="4" width="16" height="16" rx="2"/></svg>
          <% end %>
          <% header.with_title { "media variant: :icon" } %>
          <% header.with_description { "A 10x10 chip with a muted fill." } %>
        <% end %>
      <% end %>
    </div>
  </div>

  <%# Inside a border %>
  <h2 class="text-base font-semibold mb-3">Inside a border</h2>
  <div class="rounded-lg border border-border bg-muted flex justify-center p-8 mb-8">
    <%= render Ui::EmptyComponent.new(class: "border border-border max-w-md") do |empty| %>
      <% empty.with_header do |header| %>
        <% header.with_title { "No integrations yet" } %>
        <% header.with_description { "Connect a service to start syncing data." } %>
      <% end %>
      <% empty.with_body do %>
        <%= render(Ui::ButtonComponent.new(size: :sm)) { "Add integration" } %>
      <% end %>
    <% end %>
  </div>
  <p class="text-sm text-neutral-600 dark:text-neutral-400 mb-8">
    <code class="text-xs bg-neutral-100 dark:bg-neutral-800 px-1 py-0.5 rounded">border-dashed</code> is in the base classes but there's no plain <code class="text-xs bg-neutral-100 dark:bg-neutral-800 px-1 py-0.5 rounded">border</code>, so nothing paints until you add one -- most Emptys sit inside a Card or another bordered surface already.
  </p>

  <%# Empty paints no background of its own, so it takes on whatever surface it's
      dropped onto -- no neutral demo box between this and #empty-preview, so a
      browser test can drive this element's background through every token surface. %>
  <div id="empty-surface-check">
    <%= render Ui::EmptyComponent.new do |empty| %>
      <% empty.with_header do |header| %>
        <% header.with_title { "On every surface" } %>
        <% header.with_description { "No background of its own -- readable on background, card, popover and muted alike." } %>
      <% end %>
    <% end %>
  </div>
</div>

<%# Usage %>
<h2 class="text-base font-semibold mb-3">Usage</h2>
<div class="rounded-lg overflow-hidden border border-neutral-800 mb-8">
  <div class="flex items-center justify-between bg-neutral-900 px-4 py-2">
    <span class="text-xs text-neutral-400">ERB</span>
    <button data-copy-target="#empty-usage" class="text-xs text-neutral-400 hover:text-white transition-colors">Copy</button>
  </div>
  <pre class="bg-neutral-950 px-5 py-4 overflow-x-auto text-sm leading-relaxed" tabindex="0"><code id="empty-usage" class="text-neutral-200"><%= h(example_empty_usage) %></code></pre>
</div>

<%# Parts %>
<h2 class="text-base font-semibold mb-3">Parts</h2>
<div class="overflow-x-auto rounded-lg border border-border mb-8">
  <table class="w-full text-sm">
    <thead class="bg-muted">
      <tr>
        <th class="text-left px-4 py-3 text-xs font-semibold text-muted-foreground uppercase tracking-wider">Slot</th>
        <th class="text-left px-4 py-3 text-xs font-semibold text-muted-foreground uppercase tracking-wider">On</th>
        <th class="text-left px-4 py-3 text-xs font-semibold text-muted-foreground uppercase tracking-wider">data-slot</th>
        <th class="text-left px-4 py-3 text-xs font-semibold text-muted-foreground uppercase tracking-wider">Description</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-border">
      <% [
        ["with_header",      "empty",  "empty-header",      "Centres media, title and description."],
        ["with_body",        "empty",  "empty-content",     "Free-form -- actions, links, whatever the empty state needs."],
        ["with_media",       "header", "empty-media",       "default or icon."],
        ["with_title",       "header", "empty-title",       "The empty state's heading text."],
        ["with_description", "header", "empty-description", "Supporting text in the muted foreground colour."],
      ].each do |slot, parent, data_slot, desc| %>
        <tr class="hover:bg-muted/50">
          <td class="px-4 py-3 font-mono text-xs text-primary"><%= slot %></td>
          <td class="px-4 py-3 text-muted-foreground"><%= parent %></td>
          <td class="px-4 py-3 font-mono text-xs text-muted-foreground"><%= data_slot %></td>
          <td class="px-4 py-3 text-muted-foreground"><%= desc %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<%# Notes %>
<h2 class="text-base font-semibold mb-3">Notes</h2>
<ul class="space-y-2 text-sm text-neutral-600 dark:text-neutral-400 list-disc list-inside">
  <li>Parts always render in the same order -- header, body -- whatever order you call them in, and media, title, description nest inside the header in that order too.</li>
  <li>Empty is structural: a plain <code class="text-xs bg-neutral-100 dark:bg-neutral-800 px-1 py-0.5 rounded">&lt;div&gt;</code> throughout, no invented role -- there's nothing here assistive tech needs announced as a group.</li>
  <li>Title and description text reach 4.5:1 on <code class="text-xs bg-neutral-100 dark:bg-neutral-800 px-1 py-0.5 rounded">--background</code> and <code class="text-xs bg-neutral-100 dark:bg-neutral-800 px-1 py-0.5 rounded">--card</code> in both light and dark mode.</li>
</ul>
