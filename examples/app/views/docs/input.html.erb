<% content_for :title, "Input" %>
<div class="mb-8">
  <p class="mb-2 text-xs font-semibold uppercase tracking-wider text-violet-600 dark:text-violet-400">Components</p>
  <h1 class="text-3xl font-bold tracking-tight mb-3">Input</h1>
  <p class="text-neutral-600 dark:text-neutral-400">
    A native <code class="text-xs bg-neutral-100 dark:bg-neutral-800 px-1 py-0.5 rounded font-mono">&lt;input&gt;</code>
    styled as a form control, drawn entirely from the design tokens. No variants — size and shape come from your
    <code class="text-xs bg-neutral-100 dark:bg-neutral-800 px-1 py-0.5 rounded font-mono">class:</code>.
  </p>
</div>

<%# Preview %>
<h2 class="text-base font-semibold mb-3">Preview</h2>
<div id="input-preview" class="rounded-lg border border-neutral-200 dark:border-neutral-800 bg-neutral-50 dark:bg-neutral-900 flex flex-wrap items-start gap-6 p-12 mb-8">
  <div class="grid gap-2 w-56">
    <%= render(Ui::LabelComponent.new(for: "default-input", class: "text-xs font-mono text-neutral-600 dark:text-neutral-400")) { "default" } %>
    <%= render Ui::InputComponent.new(id: "default-input", name: "default", value: "Jane Cooper") %>
  </div>
  <div class="grid gap-2 w-56">
    <%= render(Ui::LabelComponent.new(for: "placeholder-input", class: "text-xs font-mono text-neutral-600 dark:text-neutral-400")) { "placeholder" } %>
    <%= render Ui::InputComponent.new(id: "placeholder-input", name: "placeholder", placeholder: "you@example.com") %>
  </div>
  <div class="grid gap-2 w-56">
    <%= render(Ui::LabelComponent.new(for: "focused-input", class: "text-xs font-mono text-neutral-600 dark:text-neutral-400")) { "focus (tab to me)" } %>
    <%= render Ui::InputComponent.new(id: "focused-input", name: "focused", value: "Tab to me") %>
  </div>
  <div class="grid gap-2 w-56">
    <%= render(Ui::LabelComponent.new(for: "invalid-input", class: "text-xs font-mono text-neutral-600 dark:text-neutral-400")) { "invalid" } %>
    <%= render Ui::InputComponent.new(id: "invalid-input", name: "invalid", value: "not-an-email", aria: { invalid: true }) %>
  </div>
  <div class="grid gap-2 w-56">
    <%= render(Ui::LabelComponent.new(for: "disabled-input", class: "text-xs font-mono text-neutral-600 dark:text-neutral-400")) { "disabled" } %>
    <%= render Ui::InputComponent.new(id: "disabled-input", name: "disabled", value: "Can't touch this", disabled: true) %>
  </div>
  <div class="grid gap-2 w-56">
    <%= render(Ui::LabelComponent.new(for: "password-input", class: "text-xs font-mono text-neutral-600 dark:text-neutral-400")) { "type: password" } %>
    <%= render Ui::InputComponent.new(type: "password", id: "password-input", name: "password", value: "hunter2") %>
  </div>
</div>
<p class="text-sm text-neutral-600 dark:text-neutral-400 mb-8">
  Tab to the "focused" field to see the focus ring — an offset outline drawn from the
  <code class="text-xs bg-neutral-100 dark:bg-neutral-800 px-1 py-0.5 rounded font-mono">--ring</code> token, the same idiom Button uses.
</p>

<%# Usage %>
<h2 class="text-base font-semibold mb-3">Usage</h2>
<div class="rounded-lg overflow-hidden border border-neutral-800 mb-8">
  <div class="flex items-center justify-between bg-neutral-900 px-4 py-2">
    <span class="text-xs text-neutral-400">ERB</span>
    <button data-copy-target="#input-usage" class="text-xs text-neutral-400 hover:text-white transition-colors">Copy</button>
  </div>
  <pre class="bg-neutral-950 px-5 py-4 overflow-x-auto text-sm leading-relaxed"><code id="input-usage" class="text-neutral-200"><%= h(example_input_usage) %></code></pre>
</div>

<%# Options %>
<h2 class="text-base font-semibold mb-3">Options</h2>
<div class="overflow-x-auto rounded-lg border border-neutral-200 dark:border-neutral-800 mb-8">
  <table class="w-full text-sm">
    <thead class="bg-neutral-50 dark:bg-neutral-900">
      <tr>
        <th class="text-left px-4 py-3 text-xs font-semibold text-neutral-500 uppercase tracking-wider">Name</th>
        <th class="text-left px-4 py-3 text-xs font-semibold text-neutral-500 uppercase tracking-wider">Type</th>
        <th class="text-left px-4 py-3 text-xs font-semibold text-neutral-500 uppercase tracking-wider">Default</th>
        <th class="text-left px-4 py-3 text-xs font-semibold text-neutral-500 uppercase tracking-wider">Description</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-neutral-100 dark:divide-neutral-800">
      <% [
        ["type",         "String",  '"text"', "The input type attribute — text, email, password, and so on."],
        ["class",        "String",  "nil",    "Merged over the default classes with tailwind_merge — the caller always wins."],
        ["aria-invalid", "Boolean", "nil",    "Set aria: { invalid: true } to draw the invalid boundary and focus colour. Not a keyword, so field binding can set it later."],
        ["disabled",     "Boolean", "nil",    "Forwarded straight to the native disabled attribute."],
        ["…",            "Any",     "—",      "Every other keyword (id:, name:, value:, placeholder:, data:, aria:, …) is forwarded to the root element."],
      ].each do |name, type, default, desc| %>
        <tr class="hover:bg-neutral-50 dark:hover:bg-neutral-900/50">
          <td class="px-4 py-3 font-mono text-xs text-violet-600 dark:text-violet-400"><%= name %></td>
          <td class="px-4 py-3 text-neutral-500"><%= type %></td>
          <td class="px-4 py-3 font-mono text-xs text-neutral-400"><%= default %></td>
          <td class="px-4 py-3 text-neutral-600 dark:text-neutral-400"><%= desc %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<%# Notes %>
<h2 class="text-base font-semibold mb-3">Notes</h2>
<ul class="space-y-2 text-sm text-neutral-600 dark:text-neutral-400 list-disc list-inside">
  <li>The fill is transparent in light mode and a translucent <code class="text-xs bg-neutral-100 dark:bg-neutral-800 px-1 py-0.5 rounded">--muted</code> tint in dark, so it takes the colour of whatever surface it sits on rather than a fixed patch.</li>
  <li>The boundary comes from <code class="text-xs bg-neutral-100 dark:bg-neutral-800 px-1 py-0.5 rounded">--input</code>, never the fill — that keeps the boundary at 3:1 independent of the surface tint.</li>
  <li>No Stimulus controller. Pair it with <code class="text-xs bg-neutral-100 dark:bg-neutral-800 px-1 py-0.5 rounded">Ui::LabelComponent</code> for the field's name.</li>
</ul>
