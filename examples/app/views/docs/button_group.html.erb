<% content_for :title, "Button Group" %>
<div class="mb-8">
  <p class="mb-2 text-xs font-semibold uppercase tracking-wider text-violet-600 dark:text-violet-400">Components</p>
  <h1 class="text-3xl font-bold tracking-tight mb-3">Button Group</h1>
  <p class="text-neutral-600 dark:text-neutral-400">
    <code class="text-xs bg-neutral-100 dark:bg-neutral-800 px-1 py-0.5 rounded font-mono">role="group"</code>
    around a call-ordered mix of real <code class="text-xs bg-neutral-100 dark:bg-neutral-800 px-1 py-0.5 rounded font-mono">Ui::ButtonComponent</code>
    and <code class="text-xs bg-neutral-100 dark:bg-neutral-800 px-1 py-0.5 rounded font-mono">Ui::SeparatorComponent</code> instances, plus a text chip part, sharing one merged border.
  </p>
</div>

<div id="button_group-preview">
  <%# Horizontal %>
  <h2 class="text-base font-semibold mb-3">Horizontal</h2>
  <div class="rounded-lg border border-neutral-200 dark:border-neutral-800 bg-neutral-50 dark:bg-neutral-900 flex flex-wrap items-center gap-6 p-10 mb-4">
    <%= render Ui::ButtonGroupComponent.new(aria: { label: "Text alignment" }) do |group| %>
      <% group.with_item_button(variant: :outline, aria: { label: "Align left" }) do %>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M3 6h18M3 12h12M3 18h18"/></svg>
      <% end %>
      <% group.with_item_button(variant: :outline, aria: { label: "Align center" }) do %>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M3 6h18M6 12h12M3 18h18"/></svg>
      <% end %>
      <% group.with_item_button(variant: :outline, aria: { label: "Align right" }) do %>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M3 6h18M9 12h12M3 18h18"/></svg>
      <% end %>
    <% end %>

    <%= render Ui::ButtonGroupComponent.new(aria: { label: "Pagination" }) do |group| %>
      <% group.with_item_button(variant: :outline) { "1" } %>
      <% group.with_item_separator(orientation: :vertical) %>
      <% group.with_item_text { "of 10" } %>
      <% group.with_item_separator(orientation: :vertical) %>
      <% group.with_item_button(variant: :outline) { "10" } %>
    <% end %>
  </div>

  <%# Vertical %>
  <h2 class="text-base font-semibold mb-3">Vertical</h2>
  <div class="rounded-lg border border-neutral-200 dark:border-neutral-800 bg-neutral-50 dark:bg-neutral-900 flex items-start gap-6 p-10 mb-8">
    <%= render Ui::ButtonGroupComponent.new(orientation: :vertical, class: "w-40", aria: { label: "Edit actions" }) do |group| %>
      <% group.with_item_button(variant: :outline) { "Cut" } %>
      <% group.with_item_button(variant: :outline) { "Copy" } %>
      <% group.with_item_button(variant: :outline) { "Paste" } %>
    <% end %>
  </div>
</div>

<%# Usage %>
<h2 class="text-base font-semibold mb-3">Usage</h2>
<div class="rounded-lg overflow-hidden border border-neutral-800 mb-8">
  <div class="flex items-center justify-between bg-neutral-900 px-4 py-2">
    <span class="text-xs text-neutral-400">ERB</span>
    <button data-copy-target="#button_group-usage" class="text-xs text-neutral-400 hover:text-white transition-colors">Copy</button>
  </div>
  <pre class="bg-neutral-950 px-5 py-4 overflow-x-auto text-sm leading-relaxed"><code id="button_group-usage" class="text-neutral-200"><%= h(example_button_group_usage) %></code></pre>
</div>

<%# Parts %>
<h2 class="text-base font-semibold mb-3">Parts</h2>
<div class="overflow-x-auto rounded-lg border border-neutral-200 dark:border-neutral-800 mb-8">
  <table class="w-full text-sm">
    <thead class="bg-neutral-50 dark:bg-neutral-900">
      <tr>
        <th class="text-left px-4 py-3 text-xs font-semibold text-neutral-500 uppercase tracking-wider">Slot</th>
        <th class="text-left px-4 py-3 text-xs font-semibold text-neutral-500 uppercase tracking-wider">data-slot</th>
        <th class="text-left px-4 py-3 text-xs font-semibold text-neutral-500 uppercase tracking-wider">Description</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-neutral-100 dark:divide-neutral-800">
      <% [
        ["with_item_button",    "button",           "Renders the real Ui::ButtonComponent — every Button keyword (variant:, size:, aria:, …) works here."],
        ["with_item_separator", "separator",        "Renders the real Ui::SeparatorComponent. Pass orientation: the opposite of the group's own, so it stands across the buttons."],
        ["with_item_text",      "button-group-text", "A non-interactive label chip, sized and bordered to match the buttons around it."],
      ].each do |slot, data_slot, desc| %>
        <tr class="hover:bg-neutral-50 dark:hover:bg-neutral-900/50">
          <td class="px-4 py-3 font-mono text-xs text-violet-600 dark:text-violet-400"><%= slot %></td>
          <td class="px-4 py-3 font-mono text-xs text-neutral-400"><%= data_slot %></td>
          <td class="px-4 py-3 text-neutral-600 dark:text-neutral-400"><%= desc %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<%# Notes %>
<h2 class="text-base font-semibold mb-3">Notes</h2>
<ul class="space-y-2 text-sm text-neutral-600 dark:text-neutral-400 list-disc list-inside">
  <li>Children render in call order whatever mix of button/separator/text you use, the same as Card's slots — the anatomy isn't fixed, so a repeating <code class="text-xs bg-neutral-100 dark:bg-neutral-800 px-1 py-0.5 rounded">renders_many</code> with polymorphic types keeps them in the order you called them.</li>
  <li>Only the first and last button (or text chip) round their outer corners; everything between is squared and overlaps its neighbour's border by a hairline, so the shared edge isn't twice as thick.</li>
  <li>A focused button lifts itself (<code class="text-xs bg-neutral-100 dark:bg-neutral-800 px-1 py-0.5 rounded">relative z-10</code>) so its focus outline isn't clipped by the next button's overlapping border.</li>
  <li>Give the group an <code class="text-xs bg-neutral-100 dark:bg-neutral-800 px-1 py-0.5 rounded">aria-label</code> when the grouping itself carries meaning ("Text alignment", "Pagination") — it's forwarded like any other attribute, no keyword of its own.</li>
  <li>No Stimulus controller.</li>
</ul>
