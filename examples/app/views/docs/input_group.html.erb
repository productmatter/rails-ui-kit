<% content_for :title, "Input Group" %>
<div class="mb-8">
  <p class="mb-2 text-xs font-semibold uppercase tracking-wider text-primary">Components</p>
  <h1 class="text-3xl font-bold tracking-tight mb-3">Input Group</h1>
  <p class="text-muted-foreground">
    Wraps an Input, Textarea or Button with text, icon or Button addons on any side.
    The group draws the boundary and the focus ring — not the control inside it.
  </p>
</div>

<div id="input_group-preview">
  <%# Inline addons %>
  <h2 class="text-base font-semibold mb-3">Inline addons</h2>
  <div class="rounded-lg border border-border bg-muted flex flex-wrap items-start gap-6 p-12 mb-4">
    <div class="grid gap-2 w-64">
      <%= render(Ui::LabelComponent.new(for: "search-input", class: "text-xs font-mono text-neutral-600 dark:text-neutral-400")) { "leading icon (decorative)" } %>
      <%= render Ui::InputGroupComponent.new do |group| %>
        <% group.with_addon(aria: { hidden: true }) do %>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="size-4"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
        <% end %>
        <%= render Ui::InputComponent.new(id: "search-input", name: "q", placeholder: "Search") %>
      <% end %>
    </div>
    <div class="grid gap-2 w-64">
      <%= render(Ui::LabelComponent.new(for: "amount-input", class: "text-xs font-mono text-neutral-600 dark:text-neutral-400")) { "leading + trailing text" } %>
      <%= render Ui::InputGroupComponent.new do |group| %>
        <% group.with_addon(id: "amount-currency") { "$" } %>
        <%= render Ui::InputComponent.new(id: "amount-input", name: "amount", value: "120.00", aria: { describedby: "amount-currency" }) %>
        <% group.with_addon(align: "inline-end", id: "amount-unit") { "USD" } %>
      <% end %>
    </div>
    <div class="grid gap-2 w-64">
      <%= render(Ui::LabelComponent.new(for: "focused-input", class: "text-xs font-mono text-neutral-600 dark:text-neutral-400")) { "focus (tab to me)" } %>
      <%= render Ui::InputGroupComponent.new do |group| %>
        <% group.with_addon(aria: { hidden: true }) do %>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="size-4"><path d="M12 19V5M5 12l7-7 7 7"/></svg>
        <% end %>
        <%= render Ui::InputComponent.new(id: "focused-input", name: "focused", value: "Tab to me") %>
      <% end %>
    </div>
    <div class="grid gap-2 w-64">
      <%= render(Ui::LabelComponent.new(for: "invalid-input", class: "text-xs font-mono text-neutral-600 dark:text-neutral-400")) { "invalid" } %>
      <%= render Ui::InputGroupComponent.new do |group| %>
        <% group.with_addon(id: "invalid-currency") { "$" } %>
        <%= render Ui::InputComponent.new(id: "invalid-input", name: "invalid", value: "not-a-number", aria: { invalid: true, describedby: "invalid-currency" }) %>
      <% end %>
    </div>
    <div class="grid gap-2 w-64">
      <%= render(Ui::LabelComponent.new(for: "send-input", class: "text-xs font-mono text-neutral-600 dark:text-neutral-400")) { "trailing Button" } %>
      <%= render Ui::InputGroupComponent.new do |group| %>
        <%= render Ui::InputComponent.new(id: "send-input", name: "message", placeholder: "Message") %>
        <% group.with_addon(align: "inline-end") do %>
          <%= render(Ui::ButtonComponent.new(size: :sm)) { "Send" } %>
        <% end %>
      <% end %>
    </div>
  </div>
  <p class="text-sm text-neutral-600 dark:text-neutral-400 mb-8">
    The search icon is decorative (the placeholder already says "Search"), so it carries <code class="text-xs bg-neutral-100 dark:bg-neutral-800 px-1 py-0.5 rounded">aria-hidden</code>.
    The <code class="text-xs bg-neutral-100 dark:bg-neutral-800 px-1 py-0.5 rounded">$</code>/<code class="text-xs bg-neutral-100 dark:bg-neutral-800 px-1 py-0.5 rounded">USD</code> addons label the field's meaning, so the input points at them with <code class="text-xs bg-neutral-100 dark:bg-neutral-800 px-1 py-0.5 rounded">aria-describedby</code> instead.
  </p>

  <%# Block addons %>
  <h2 class="text-base font-semibold mb-3">Block addons</h2>
  <div class="rounded-lg border border-border bg-muted flex flex-wrap items-start gap-6 p-12 mb-4">
    <div class="grid gap-2 w-72">
      <%= render(Ui::LabelComponent.new(for: "message-textarea", class: "text-xs font-mono text-neutral-600 dark:text-neutral-400")) { "block-end toolbar" } %>
      <%= render Ui::InputGroupComponent.new do |group| %>
        <%= render Ui::TextareaComponent.new(id: "message-textarea", name: "message", placeholder: "Write a message", class: "min-h-20") %>
        <% group.with_addon(align: "block-end") do %>
          <%= render Ui::ButtonComponent.new(variant: :ghost, size: :icon, aria: { label: "Attach a file" }) do %>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="size-4" aria-hidden="true"><path d="M21 11 12 20a4 4 0 0 1-6-6l8-8"/></svg>
          <% end %>
          <span class="ml-auto text-xs">0/280</span>
        <% end %>
      <% end %>
    </div>
  </div>
  <p class="text-sm text-neutral-600 dark:text-neutral-400 mb-8">
    A <code class="text-xs bg-neutral-100 dark:bg-neutral-800 px-1 py-0.5 rounded">block-start</code>/<code class="text-xs bg-neutral-100 dark:bg-neutral-800 px-1 py-0.5 rounded">block-end</code> addon spans the full width and switches the group from a row to a column. The attach button is icon-only, so it carries its own <code class="text-xs bg-neutral-100 dark:bg-neutral-800 px-1 py-0.5 rounded">aria-label</code>.
  </p>
</div>

<%# Usage %>
<h2 class="text-base font-semibold mb-3">Usage</h2>
<div class="rounded-lg overflow-hidden border border-neutral-800 mb-8">
  <div class="flex items-center justify-between bg-neutral-900 px-4 py-2">
    <span class="text-xs text-neutral-400">ERB</span>
    <button data-copy-target="#input_group-usage" class="text-xs text-neutral-400 hover:text-white transition-colors">Copy</button>
  </div>
  <pre class="bg-neutral-950 px-5 py-4 overflow-x-auto text-sm leading-relaxed" tabindex="0"><code id="input_group-usage" class="text-neutral-200"><%= h(example_input_group_usage) %></code></pre>
</div>

<%# Parts %>
<h2 class="text-base font-semibold mb-3">Parts</h2>
<div class="overflow-x-auto rounded-lg border border-border mb-8">
  <table class="w-full text-sm">
    <thead class="bg-muted">
      <tr>
        <th class="text-left px-4 py-3 text-xs font-semibold text-muted-foreground uppercase tracking-wider">Slot</th>
        <th class="text-left px-4 py-3 text-xs font-semibold text-muted-foreground uppercase tracking-wider">data-slot</th>
        <th class="text-left px-4 py-3 text-xs font-semibold text-muted-foreground uppercase tracking-wider">Description</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-border">
      <% [
        ["(block content)", "input / textarea / button", "The control — render Ui::InputComponent, Ui::TextareaComponent or Ui::ButtonComponent directly. It isn't a slot Input Group owns, so its own boundary, fill and focus ring are suppressed by the group's own selectors, not by editing the control."],
        ["with_addon(align:)", "input-group-addon", "Text, an icon, or a Button, positioned by align: inline-start (default), inline-end, block-start or block-end. Call it as many times as you have addons, in any order."],
      ].each do |slot, data_slot, desc| %>
        <tr class="hover:bg-muted/50">
          <td class="px-4 py-3 font-mono text-xs text-primary"><%= slot %></td>
          <td class="px-4 py-3 font-mono text-xs text-muted-foreground"><%= data_slot %></td>
          <td class="px-4 py-3 text-muted-foreground"><%= desc %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<%# Notes %>
<h2 class="text-base font-semibold mb-3">Notes</h2>
<ul class="space-y-2 text-sm text-neutral-600 dark:text-neutral-400 list-disc list-inside">
  <li>Focus indicator: tab into the control and the <em>group</em> draws the offset outline (<code class="text-xs bg-neutral-100 dark:bg-neutral-800 px-1 py-0.5 rounded">has-[[data-slot=input]:focus-visible]:outline-2</code>), while the control's own <code class="text-xs bg-neutral-100 dark:bg-neutral-800 px-1 py-0.5 rounded">focus-visible:outline-2</code> is overridden down to <code class="text-xs bg-neutral-100 dark:bg-neutral-800 px-1 py-0.5 rounded">outline-0</code> — never <code class="text-xs bg-neutral-100 dark:bg-neutral-800 px-1 py-0.5 rounded">outline-none</code>, which would also blank the group's own ring since both read the same underlying outline-style custom property.</li>
  <li>Same treatment for the boundary and fill: the control renders <code class="text-xs bg-neutral-100 dark:bg-neutral-800 px-1 py-0.5 rounded">border-transparent bg-transparent shadow-none</code> inside a group, and the group's own <code class="text-xs bg-neutral-100 dark:bg-neutral-800 px-1 py-0.5 rounded">border-input bg-transparent dark:bg-muted/50</code> is what you see. These are the modifier-scoped defaults this component documents (rule 1) — pass the same modifier on the control's own class: to keep its ring or border instead.</li>
  <li>A text addon that labels the control (a currency symbol, a unit) should be associated with it: give the addon an <code class="text-xs bg-neutral-100 dark:bg-neutral-800 px-1 py-0.5 rounded">id:</code> and point the control's <code class="text-xs bg-neutral-100 dark:bg-neutral-800 px-1 py-0.5 rounded">aria-describedby</code> at it, since the group renders the control as plain content rather than a slot it could wire up itself.</li>
  <li>An icon-only addon or Button needs its own <code class="text-xs bg-neutral-100 dark:bg-neutral-800 px-1 py-0.5 rounded">aria-label</code>; a purely decorative icon takes <code class="text-xs bg-neutral-100 dark:bg-neutral-800 px-1 py-0.5 rounded">aria-hidden</code> instead.</li>
  <li>No Stimulus controller.</li>
</ul>
