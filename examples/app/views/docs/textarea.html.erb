<% content_for :title, "Textarea" %>
<div class="mb-8">
  <p class="mb-2 text-xs font-semibold uppercase tracking-wider text-violet-600 dark:text-violet-400">Components</p>
  <h1 class="text-3xl font-bold tracking-tight mb-3">Textarea</h1>
  <p class="text-neutral-600 dark:text-neutral-400">
    A native <code class="text-xs bg-neutral-100 dark:bg-neutral-800 px-1 py-0.5 rounded font-mono">&lt;textarea&gt;</code>,
    the same control styling as <code class="text-xs bg-neutral-100 dark:bg-neutral-800 px-1 py-0.5 rounded font-mono">Ui::InputComponent</code>. No variants.
  </p>
</div>

<%# Preview %>
<h2 class="text-base font-semibold mb-3">Preview</h2>
<div id="textarea-preview" class="rounded-lg border border-neutral-200 dark:border-neutral-800 bg-neutral-50 dark:bg-neutral-900 flex flex-wrap items-start gap-6 p-12 mb-8">
  <div class="grid gap-2 w-56">
    <%= render(Ui::LabelComponent.new(for: "default-textarea", class: "text-xs font-mono text-neutral-600 dark:text-neutral-400")) { "default" } %>
    <%= render Ui::TextareaComponent.new(id: "default-textarea", name: "default") do %>Ship the release notes with the changelog.<% end %>
  </div>
  <div class="grid gap-2 w-56">
    <%= render(Ui::LabelComponent.new(for: "placeholder-textarea", class: "text-xs font-mono text-neutral-600 dark:text-neutral-400")) { "placeholder" } %>
    <%= render Ui::TextareaComponent.new(id: "placeholder-textarea", name: "placeholder", placeholder: "Add a note…") %>
  </div>
  <div class="grid gap-2 w-56">
    <%= render(Ui::LabelComponent.new(for: "focused-textarea", class: "text-xs font-mono text-neutral-600 dark:text-neutral-400")) { "focus (tab to me)" } %>
    <%= render Ui::TextareaComponent.new(id: "focused-textarea", name: "focused") do %>Tab to me<% end %>
  </div>
  <div class="grid gap-2 w-56">
    <%= render(Ui::LabelComponent.new(for: "invalid-textarea", class: "text-xs font-mono text-neutral-600 dark:text-neutral-400")) { "invalid" } %>
    <%= render Ui::TextareaComponent.new(id: "invalid-textarea", name: "invalid", aria: { invalid: true }) do %>Too short<% end %>
  </div>
  <div class="grid gap-2 w-56">
    <%= render(Ui::LabelComponent.new(for: "disabled-textarea", class: "text-xs font-mono text-neutral-600 dark:text-neutral-400")) { "disabled" } %>
    <%= render Ui::TextareaComponent.new(id: "disabled-textarea", name: "disabled", disabled: true) do %>Locked<% end %>
  </div>
</div>
<p class="text-sm text-neutral-600 dark:text-neutral-400 mb-8">
  Tab to the "focused" field to see the focus ring — the same offset-outline idiom as Button and Input.
</p>

<%# Usage %>
<h2 class="text-base font-semibold mb-3">Usage</h2>
<div class="rounded-lg overflow-hidden border border-neutral-800 mb-8">
  <div class="flex items-center justify-between bg-neutral-900 px-4 py-2">
    <span class="text-xs text-neutral-400">ERB</span>
    <button data-copy-target="#textarea-usage" class="text-xs text-neutral-400 hover:text-white transition-colors">Copy</button>
  </div>
  <pre class="bg-neutral-950 px-5 py-4 overflow-x-auto text-sm leading-relaxed"><code id="textarea-usage" class="text-neutral-200"><%= h(example_textarea_usage) %></code></pre>
</div>

<%# Options %>
<h2 class="text-base font-semibold mb-3">Options</h2>
<div class="overflow-x-auto rounded-lg border border-neutral-200 dark:border-neutral-800 mb-8">
  <table class="w-full text-sm">
    <thead class="bg-neutral-50 dark:bg-neutral-900">
      <tr>
        <th class="text-left px-4 py-3 text-xs font-semibold text-neutral-500 uppercase tracking-wider">Name</th>
        <th class="text-left px-4 py-3 text-xs font-semibold text-neutral-500 uppercase tracking-wider">Type</th>
        <th class="text-left px-4 py-3 text-xs font-semibold text-neutral-500 uppercase tracking-wider">Default</th>
        <th class="text-left px-4 py-3 text-xs font-semibold text-neutral-500 uppercase tracking-wider">Description</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-neutral-100 dark:divide-neutral-800">
      <% [
        ["class",        "String",  "nil", "Merged over the default classes with tailwind_merge — the caller always wins."],
        ["aria-invalid", "Boolean", "nil", "Set aria: { invalid: true } to draw the invalid boundary and focus colour. Not a keyword, so field binding can set it later."],
        ["disabled",     "Boolean", "nil", "Forwarded straight to the native disabled attribute."],
        ["…",            "Any",     "—",   "Every other keyword (id:, name:, placeholder:, data:, aria:, …) is forwarded to the root element."],
      ].each do |name, type, default, desc| %>
        <tr class="hover:bg-neutral-50 dark:hover:bg-neutral-900/50">
          <td class="px-4 py-3 font-mono text-xs text-violet-600 dark:text-violet-400"><%= name %></td>
          <td class="px-4 py-3 text-neutral-500"><%= type %></td>
          <td class="px-4 py-3 font-mono text-xs text-neutral-400"><%= default %></td>
          <td class="px-4 py-3 text-neutral-600 dark:text-neutral-400"><%= desc %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<%# Notes %>
<h2 class="text-base font-semibold mb-3">Notes</h2>
<ul class="space-y-2 text-sm text-neutral-600 dark:text-neutral-400 list-disc list-inside">
  <li>There is no <code class="text-xs bg-neutral-100 dark:bg-neutral-800 px-1 py-0.5 rounded">value:</code> keyword — a <code class="text-xs bg-neutral-100 dark:bg-neutral-800 px-1 py-0.5 rounded">&lt;textarea&gt;</code> has no value attribute, its text is its element content, so pass it as the block.</li>
  <li>Same fill, boundary and focus treatment as <code class="text-xs bg-neutral-100 dark:bg-neutral-800 px-1 py-0.5 rounded">Ui::InputComponent</code>.</li>
  <li>No Stimulus controller, and no auto-resize behaviour — that would need one.</li>
</ul>
