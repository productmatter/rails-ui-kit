# The docs image (examples/Dockerfile) builds from the repo root. It needs the gem's app/, config/,
# lib/ and docs/guides/, the Gemfile and gemspec, and examples/ -- nothing else.

.git/
.github/
.treeline/
.bundle/
.env*
**/.DS_Store
*.gem
pkg/

# Resolved fresh in the image, as in CI; see examples/Dockerfile.
Gemfile.lock
gemfiles/

node_modules/
package.json
package-lock.json

tmp/
log/
test/
# The product record stays out; the guides are packaged content.
docs/*
!docs/guides/

examples/tmp/
examples/log/
examples/public/assets/
examples/app/assets/builds/*
!examples/app/assets/builds/.gitkeep
examples/Dockerfile
examples/fly.toml
